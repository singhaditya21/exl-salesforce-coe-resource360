{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resource360.example.invalid/contracts/resource360-master-data-envelope-R360-MOCK-1.2.schema.json",
  "title": "Resource 360 master-data ingestion envelope",
  "description": "Transport contract for the Salesforce REST resource /services/apexrest/resource360/v1/master-data/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "sourceSystem", "entityType", "contractVersion", "sourceCutoff", "records"],
  "properties": {
    "runId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 120 },
    "entityType": {
      "type": "string",
      "enum": ["Employee", "Engagement", "Capability", "Credential", "LearningAchievement", "CommercialReference", "OrgUnit", "Portfolio"]
    },
    "contractVersion": { "const": "R360-MOCK-1.2" },
    "sourceCutoff": { "type": "string", "format": "date-time" },
    "allOrNone": { "type": "boolean", "default": false },
    "records": { "type": "array", "maxItems": 200, "items": { "type": "object" } }
  },
  "x-resource360": {
    "idempotencyKey": "runId",
    "collisionPolicy": "For a duplicate stable identity, select the lexicographically lowest canonical payload and retain a redacted error with payload hash.",
    "errorPersistence": "R360_Integration_Error__c",
    "runEvidence": "R360_Integration_Run__c",
    "payloadRetention": "Source payload bodies are not retained.",
    "decisionId": "R360-MOCK-ACTIVATION-2026-08-24"
  }
}

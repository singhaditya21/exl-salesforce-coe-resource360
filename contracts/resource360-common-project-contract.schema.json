{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resource360.example.invalid/contracts/resource360-common-project-contract-R360-MOCK-1.2.schema.json",
  "title": "Resource 360 common engagement/project contract",
  "description": "Versioned sanitized-mock contract consumed by Resource 360 for one authoritative engagement/project identity. EXL production source ownership and field certification remain activation gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engagementId",
    "name",
    "startDate",
    "endDate",
    "status",
    "revenueType",
    "currency"
  ],
  "properties": {
    "engagementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Canonical engagement identity; never generated by a downstream Resource 360 module."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["Draft", "Active", "On Hold", "Completed", "Cancelled"] },
    "revenueType": { "type": "string", "enum": ["Time and Materials", "Fixed Price", "Managed Service", "Internal"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "confidentiality": { "type": "string", "enum": ["EXL Internal", "Confidential", "Restricted"] },
    "portfolioId": { "type": "string", "maxLength": 80 },
    "salesforceTower": { "type": "string", "maxLength": 120 },
    "industry": { "type": "string", "maxLength": 120 },
    "poValue": { "type": "number", "minimum": 0 }
  },
  "x-resource360": {
    "contractVersion": "R360-MOCK-1.2",
    "authoritativeSource": "Mock EXL Engagement Master",
    "salesforceTarget": "Engagement__c",
    "externalIdField": "Engagement_ID__c",
    "lineageFields": ["Source_Last_Sync__c"],
    "freshnessHours": 4,
    "blocking": true,
    "dataClassification": "Confidential",
    "decisionId": "R360-MOCK-ACTIVATION-2026-08-24"
  }
}

public with sharing class Resource360Service {
    public class ServiceResult {
        @AuraEnabled public Boolean success;
        @AuraEnabled public String message;
        @AuraEnabled public Id recordId;
        @AuraEnabled public String correlationId;
        public ServiceResult(Boolean success,String message,Id recordId,String correlationId){this.success=success;this.message=message;this.recordId=recordId;this.correlationId=correlationId;}
    }

    @AuraEnabled(cacheable=true)
    public static String getWorkspaceData(){
        Map<String,Object> payload=new Map<String,Object>();
        payload.put('generatedAt',System.now());
        User runningUser=[SELECT Id,Name FROM User WHERE Id=:UserInfo.getUserId() WITH USER_MODE];payload.put('user',runningUser);
        payload.put('activeRoles',new List<String>(Resource360Security.activeRoles()));
        payload.put('classifications',Resource360Classification.activeValues());
        payload.put('deliveryRoles',Resource360RoleCatalog.activeRoles());
        payload.put('configuration',JSON.deserializeUntyped(Resource360ConfigurationService.publicSnapshot()));
        payload.put('configurationCapabilities',new Map<String,Boolean>{'manage'=>Resource360Security.hasPermission('Resource360_Manage_Configuration'),'approve'=>Resource360Security.hasPermission('Resource360_Approve_Configuration'),'audit'=>Resource360Security.hasPermission('Resource360_View_Audit')});
        if(Resource360Security.hasPermission('Resource360_Manage_Configuration')||Resource360Security.hasPermission('Resource360_Approve_Configuration')||Resource360Security.hasPermission('Resource360_View_Audit'))payload.put('configurationCatalog',Resource360ConfigurationService.catalog());else payload.put('configurationCatalog',new List<Resource360ConfigurationService.ConfigurationItem>());
        payload.put('metrics',Resource360AnalyticsService.snapshot());
        payload.put('assurance',JSON.deserializeUntyped(Resource360AssuranceService.mockAssuranceSnapshot()));
        payload.put('assuranceCapabilities',new Map<String,Boolean>{'operate'=>Resource360Security.hasPermission('Resource360_Manage_Integrations'),'viewOperations'=>Resource360Security.hasPermission('Resource360_View_Operations'),'viewAudit'=>Resource360Security.hasPermission('Resource360_View_Audit')});
        payload.put('resources',[SELECT Id,Name,Employee_ID__c,Preferred_Name__c,Work_Email__c,Primary_Role__c,Tower__c,Location__c,Grade__c,Time_Zone__c,Org_Unit_ID__c,Manager__r.Preferred_Name__c,Available_Percent__c,Daily_Capacity_Hours__c,Status__c,Source_Last_Sync__c,Work_Calendar__r.Time_Zone__c FROM Resource__c WITH USER_MODE ORDER BY Preferred_Name__c LIMIT 100]);
        payload.put('engagements',[SELECT Id,Name,Engagement_ID__c,Status__c,Start_Date__c,End_Date__c,Salesforce_Tower__c,Industry__c,Currency_Code__c,Portfolio_ID__c,Source_Last_Sync__c,Project_Manager__r.Name FROM Engagement__c WITH USER_MODE ORDER BY Name LIMIT 100]);
        payload.put('commercialReferences',[SELECT Id,Name,Engagement__c,Engagement__r.Name,External_ID__c,Reference_Type__c,Value__c,Valid_From__c,Valid_To__c,Status__c,Source_Last_Sync__c FROM Commercial_Reference__c WITH USER_MODE ORDER BY Valid_From__c DESC LIMIT 100]);
        payload.put('workUnits',[SELECT Id,Name,Engagement__c,Engagement__r.Name,Work_Unit_Code__c,Phase__c,Start_Date__c,End_Date__c,Status__c FROM Work_Unit__c WITH USER_MODE ORDER BY Start_Date__c LIMIT 200]);
        payload.put('budgets',[SELECT Id,Name,Engagement__c,Engagement__r.Name,Engagement__r.Start_Date__c,Engagement__r.End_Date__c,Version__c,Current__c,State__c,Revenue__c,Total_Cost__c,Gross_Margin__c,Margin_Percent__c,Planned_Hours__c,Approval_Level__c,Approval_Step__c,Policy_Version__c,Uplift_Percent__c,Effort_Contingency_Percent__c,Expense_Contingency_Percent__c,Travel_Rate__c,Onsite_Months__c FROM Budget__c WHERE Current__c=true WITH USER_MODE ORDER BY LastModifiedDate DESC LIMIT 100]);
        payload.put('budgetLines',[SELECT Id,Name,Budget__c,Resource__c,Resource__r.Preferred_Name__c,Role_Start__c,Role_End__c,Period_Start__c,Phase__c,Work_Unit__c,Role__c,Location__c,Planned_Hours__c,Cost_Rate__c,Planned_Cost__c,Allocation_Percent__c,Onsite__c FROM Budget_Line__c WHERE Budget__r.Current__c=true WITH USER_MODE ORDER BY Period_Start__c,Phase__c,Role__c LIMIT 500]);
        payload.put('staffingRequests',[SELECT Id,Name,Engagement__c,Engagement__r.Name,Resource__c,Resource__r.Preferred_Name__c,Requested_Role__c,Classification__c,Start_Date__c,End_Date__c,Daily_Hours__c,Priority__c,State__c,SLA_Due__c,Fit_Score__c,Decision_Reason__c,Responsible_Owner__c,Review_Date__c FROM Staffing_Request__c WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 100]);
        payload.put('allocations',[SELECT Id,Name,Resource__c,Resource__r.Preferred_Name__c,Engagement__c,Engagement__r.Name,Role__c,Classification__c,Billable__c,Billable_Snapshot__c,Start_Date__c,End_Date__c,Daily_Hours__c,Allocation_Percent__c,Responsible_Owner__c,Review_Date__c,State__c,Version__c,Current__c FROM Allocation__c WHERE Current__c=true WITH USER_MODE ORDER BY Start_Date__c LIMIT 100]);
        payload.put('capabilities',[SELECT Id,Name,Capability_ID__c,Type__c,Tower__c,Category__c,Active__c FROM Capability__c WHERE Active__c=true WITH USER_MODE ORDER BY Name LIMIT 200]);
        payload.put('skillClaims',[SELECT Id,Name,Resource__c,Resource__r.Preferred_Name__c,Capability__c,Capability__r.Name,Capability__r.Type__c,Requested_Level__c,Approved_Level__c,Years_Experience__c,Last_Used__c,State__c,Submitted_At__c,Decision_At__c,Reviewer__r.Name,Decision_Note__c FROM Skill_Claim__c WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 100]);
        payload.put('credentials',[SELECT Id,Name,Resource__c,Resource__r.Preferred_Name__c,Credential_Name__c,Issuer__c,State__c,Issue_Date__c,Expiry_Date__c,Maintenance_Date__c,Verification_Source__c,Verified_At__c,Last_Checked_At__c FROM Credential__c WITH USER_MODE ORDER BY Credential_Name__c LIMIT 100]);
        payload.put('learningAchievements',[SELECT Id,Name,Achievement_ID__c,Resource__c,Capability__c,Capability__r.Name,Course_Name__c,Provider__c,Completed_On__c,State__c,Source_Last_Sync__c FROM R360_Learning_Achievement__c WITH USER_MODE ORDER BY Completed_On__c DESC LIMIT 200]);
        payload.put('projectEvidence',[SELECT Id,Name,Evidence_Key__c,Resource__c,Engagement__c,Engagement__r.Name,Engagement__r.Industry__c,Capability__c,Capability__r.Name,Role__c,Start_Date__c,End_Date__c,State__c,Verified_By__r.Name,Verified_At__c,Summary__c FROM R360_Project_Evidence__c WITH USER_MODE ORDER BY End_Date__c DESC LIMIT 200]);
        payload.put('timesheets',[SELECT Id,Name,Resource__c,Resource__r.Preferred_Name__c,Week_Start__c,Due_At__c,Decision_Due_At__c,Escalated_At__c,Status__c,Version__c,Current__c,Submitted_At__c,Decision_At__c,Decision_Note__c,Auto_Approved__c,Exception_Code__c,Correction_Parent__c,Correction_Requested_By__c,Dual_Control_Required__c,Approval_Step__c,Required_Approval_Role__c FROM Timesheet__c WHERE Current__c=true WITH USER_MODE ORDER BY Week_Start__c DESC LIMIT 100]);
        payload.put('timeEntries',[SELECT Id,Name,Timesheet__c,Allocation__c,Engagement__r.Name,Work_Date__c,Hours__c,Role__c,State__c,Version__c,Comment__c FROM Time_Entry__c WHERE Timesheet__r.Current__c=true WITH USER_MODE ORDER BY Work_Date__c DESC LIMIT 200]);
        if(Resource360Security.hasPermission('Resource360_View_Operations')||Resource360Security.hasPermission('Resource360_View_Audit'))payload.put('notifications',[SELECT Id,Name,Title__c,Message__c,Severity__c,State__c,Read__c,Occurred_At__c,Deep_Link__c,Resolution_Status__c,Accountable_Owner__c,Accountable_Owner__r.Name,Recipient__r.Name,First_Seen_At__c,Closed_At__c,Closed_By__r.Name,Closure_Note__c FROM R360_Notification__c WITH USER_MODE ORDER BY Occurred_At__c DESC LIMIT 100]);else payload.put('notifications',[SELECT Id,Name,Title__c,Message__c,Severity__c,State__c,Read__c,Occurred_At__c,Deep_Link__c,Resolution_Status__c,Accountable_Owner__c,Accountable_Owner__r.Name,Recipient__r.Name,First_Seen_At__c,Closed_At__c,Closed_By__r.Name,Closure_Note__c FROM R360_Notification__c WHERE Recipient__c=:UserInfo.getUserId() WITH USER_MODE ORDER BY Occurred_At__c DESC LIMIT 100]);
        if(Resource360Security.hasPermission('Resource360_View_Audit'))payload.put('auditEvents',[SELECT Id,Name,Correlation_ID__c,Active_Role__c,Action__c,Entity_Type__c,Entity_ID__c,Reason_Code__c,Detail__c,Payload_Hash__c,Occurred_At__c,Actor__r.Name FROM R360_Audit_Event__c WITH USER_MODE ORDER BY Occurred_At__c DESC LIMIT 100]);else payload.put('auditEvents',new List<R360_Audit_Event__c>());
        if(Resource360Security.hasPermission('Resource360_View_Operations')){
            payload.put('integrationRuns',[SELECT Id,Name,Run_ID__c,Source_System__c,Entity_Type__c,State__c,Started_At__c,Completed_At__c,Source_Cutoff__c,Processed_Count__c,Success_Count__c,Failure_Count__c,Inserted_Count__c,Updated_Count__c,Deactivated_Count__c,Collision_Count__c,Completeness_Percent__c,Freshness_State__c,Contract_Version__c,Source_File_Name__c,Source_File_Hash__c,Commit_Mode__c,Detail__c FROM R360_Integration_Run__c WITH USER_MODE ORDER BY Started_At__c DESC LIMIT 50]);
            payload.put('integrationErrors',[SELECT Id,Name,Integration_Run__c,Integration_Run__r.Run_ID__c,Row_Number__c,External_Record_ID__c,Error_Code__c,Error_Message__c,State__c,Retry_Count__c,Next_Retry_At__c FROM R360_Integration_Error__c WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 200]);
            payload.put('outboxEvents',[SELECT Id,Name,Event_Type__c,Aggregate_Type__c,Aggregate_ID__c,State__c,Attempt_Count__c,Next_Attempt_At__c,Published_At__c,Last_Error__c FROM R360_Outbox_Event__c WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 50]);
        }else{payload.put('integrationRuns',new List<R360_Integration_Run__c>());payload.put('integrationErrors',new List<R360_Integration_Error__c>());payload.put('outboxEvents',new List<R360_Outbox_Event__c>());}
        if(Resource360Security.hasPermission('Resource360_Manage_Configuration')||Resource360Security.hasPermission('Resource360_Approve_Configuration')||Resource360Security.hasPermission('Resource360_View_Operations')){
            payload.put('workCalendars',[SELECT Id,Name,Calendar_ID__c,Time_Zone__c,Work_Days__c,Daily_Capacity_Hours__c,Effective_From__c,Effective_To__c,Current__c FROM R360_Work_Calendar__c WITH USER_MODE ORDER BY Name LIMIT 100]);
            payload.put('calendarExceptions',[SELECT Id,Name,Calendar__c,Calendar__r.Name,Exception_Key__c,Exception_Date__c,Capacity_Hours__c,Reason__c FROM R360_Calendar_Exception__c WITH USER_MODE ORDER BY Exception_Date__c LIMIT 200]);
        }else{payload.put('workCalendars',new List<R360_Work_Calendar__c>());payload.put('calendarExceptions',new List<R360_Calendar_Exception__c>());}
        if(Resource360Security.hasPermission('Resource360_View_Operations')||Resource360Security.hasPermission('Resource360_View_Audit'))payload.put('roleScopes',[SELECT Id,Name,User__c,User__r.Name,Business_Role__c,Org_Unit_ID__c,Portfolio_ID__c,Valid_From__c,Valid_To__c,Active__c,Assignment_Source__c,Approval_Reference__c,Last_Certified_At__c FROM R360_Role_Scope__c WITH USER_MODE ORDER BY User__r.Name,Business_Role__c LIMIT 200]);else payload.put('roleScopes',new List<R360_Role_Scope__c>());
        if(Resource360Security.hasPermission('Resource360_Approve_Budgets')||Resource360Security.hasPermission('Resource360_Approve_Timesheets')||Resource360Security.hasPermission('Resource360_View_Audit'))payload.put('approvalDecisions',[SELECT Id,Name,Entity_Type__c,Entity_ID__c,Entity_Version__c,Step_Number__c,Required_Role__c,State__c,Approver__r.Name,Decided_At__c,Decision_Note__c FROM R360_Approval_Decision__c WITH USER_MODE ORDER BY CreatedDate DESC LIMIT 100]);else payload.put('approvalDecisions',new List<R360_Approval_Decision__c>());
        return JSON.serialize(payload);
    }

    @AuraEnabled public static ServiceResult createStaffingRequest(Id engagementId,Id resourceId,String requestedRole,String classification,Date startDate,Date endDate,Decimal dailyHours,String idempotencyKey){return Resource360StaffingService.create(engagementId,resourceId,requestedRole,classification,startDate,endDate,dailyHours,null,null,null,null,idempotencyKey);}
    @AuraEnabled public static ServiceResult createStaffingRequestV2(Id engagementId,Id resourceId,String requestedRole,String classification,Date startDate,Date endDate,Decimal dailyHours,Id responsibleOwnerId,Date reviewDate,String controlReason,String sourceCriteria,String idempotencyKey){return Resource360StaffingService.create(engagementId,resourceId,requestedRole,classification,startDate,endDate,dailyHours,responsibleOwnerId,reviewDate,controlReason,sourceCriteria,idempotencyKey);}
    @AuraEnabled public static ServiceResult decideStaffingRequest(Id requestId,Boolean accept,String note,String activeRole){return Resource360StaffingService.decide(requestId,accept,note);}
    @AuraEnabled public static ServiceResult modifyAllocation(Id allocationId,Date startDate,Date endDate,Decimal dailyHours,String roleName,String classification,Id responsibleOwnerId,Date reviewDate,String reason){return Resource360StaffingService.modifyAllocation(allocationId,startDate,endDate,dailyHours,roleName,classification,responsibleOwnerId,reviewDate,reason);}
    @AuraEnabled public static ServiceResult deallocate(Id allocationId,Date effectiveEndDate,String reason){return Resource360StaffingService.deallocate(allocationId,effectiveEndDate,reason);}
    @AuraEnabled public static ServiceResult splitAllocation(Id allocationId,Date splitDate,Decimal firstDailyHours,Decimal secondDailyHours,String reason){return Resource360StaffingService.splitAllocation(allocationId,splitDate,firstDailyHours,secondDailyHours,reason);}
    @AuraEnabled public static ServiceResult transferStaffingOwnership(Id requestId,Id newOwnerId,Date nextReviewDate,String reason){return Resource360StaffingService.transferOwnership(requestId,newOwnerId,nextReviewDate,reason);}

    @AuraEnabled public static ServiceResult submitBudget(Id budgetId){return Resource360BudgetService.submit(budgetId);}
    @AuraEnabled public static ServiceResult decideBudget(Id budgetId,Boolean approve,String note,String activeRole){return Resource360BudgetService.decide(budgetId,approve,note);}
    @AuraEnabled public static ServiceResult createBudgetVersion(Id sourceBudgetId){return Resource360BudgetService.createVersion(sourceBudgetId);}
    @AuraEnabled public static ServiceResult saveBudgetDraft(Id budgetId,Decimal revenue,Decimal upliftPercent,Decimal effortContingencyPercent,Decimal expenseContingencyPercent,Decimal travelRate,Decimal onsiteMonths){return Resource360BudgetService.saveDraft(budgetId,revenue,upliftPercent,effortContingencyPercent,expenseContingencyPercent,travelRate,onsiteMonths);}
    @AuraEnabled public static ServiceResult saveBudgetLine(Id budgetId,Id lineId,Date periodStart,String phase,String workUnit,String roleName,String location,Decimal plannedHours,Decimal costRate,Decimal allocationPercent,Boolean onsite){return Resource360BudgetService.saveLine(budgetId,lineId,periodStart,phase,workUnit,roleName,location,plannedHours,costRate,allocationPercent,onsite);}
    @AuraEnabled public static ServiceResult saveBudgetRosterLine(Id budgetId,Id lineId,Id resourceId,Date periodStart,String phase,String workUnit,String roleName,String location,Decimal plannedHours,Decimal costRate,Decimal allocationPercent,Boolean onsite,Date roleStart,Date roleEnd){return Resource360BudgetService.saveRosterLine(budgetId,lineId,resourceId,periodStart,phase,workUnit,roleName,location,plannedHours,costRate,allocationPercent,onsite,roleStart,roleEnd);}

    @AuraEnabled public static ServiceResult submitSkillClaim(Id resourceId,Id capabilityId,Integer requestedLevel,Decimal yearsExperience,String evidence,String idempotencyKey){return Resource360SkillService.submitClaim(resourceId,capabilityId,requestedLevel,yearsExperience,evidence,idempotencyKey);}
    @AuraEnabled public static ServiceResult decideSkillClaim(Id claimId,Boolean approve,Integer approvedLevel,String note){return Resource360SkillService.decideClaim(claimId,approve,approvedLevel,note);}
    @AuraEnabled public static ServiceResult addCredential(Id resourceId,String credentialId,String credentialName,String issuer,Date issueDate,Date expiryDate,String evidenceUrl){return Resource360SkillService.addCredential(resourceId,credentialId,credentialName,issuer,issueDate,expiryDate,evidenceUrl);}
    @AuraEnabled public static ServiceResult verifyCredential(Id credentialId,String verificationState,String source,String note){return Resource360SkillService.verifyCredential(credentialId,verificationState,source,note);}

    @AuraEnabled public static ServiceResult createTimesheet(Id resourceId,Date weekStart){return Resource360TimeService.createTimesheet(resourceId,weekStart);}
    @AuraEnabled public static ServiceResult saveTimeEntry(Id timesheetId,Id allocationId,Date workDate,Decimal hours,Id workUnitId,String comment){return Resource360TimeService.saveEntry(timesheetId,allocationId,workDate,hours,workUnitId,comment);}
    @AuraEnabled public static ServiceResult submitTimesheet(Id timesheetId){return Resource360TimeService.submit(timesheetId);}
    @AuraEnabled public static ServiceResult decideTimesheet(Id timesheetId,Boolean approve,String note){return Resource360TimeService.decide(timesheetId,approve,note);}
    @AuraEnabled public static ServiceResult createTimeCorrection(Id timesheetId,String reason){return Resource360TimeService.createCorrection(timesheetId,reason);}
    @AuraEnabled public static ServiceResult startMockSession(String clientContext){return Resource360AssuranceService.startMockSession(clientContext);}
    @AuraEnabled public static ServiceResult closeAlert(Id notificationId,String closureNote){return Resource360AssuranceService.closeAlert(notificationId,closureNote);}
}

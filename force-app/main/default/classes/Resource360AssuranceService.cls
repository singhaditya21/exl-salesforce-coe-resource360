        if(budgetId==null)fail('Select a budget.');Date cutoff=asOfDate==null?Date.today():asOfDate;Budget__c budget=[SELECT Id,Engagement__c,Engagement__r.Name,Engagement__r.Start_Date__c,Engagement__r.End_Date__c,Version__c,State__c,Revenue__c,Total_Cost__c,Margin_Percent__c FROM Budget__c WHERE Id=:budgetId WITH USER_MODE LIMIT 1];List<Budget_Line__c>lines=[SELECT Id,Resource__c,Resource__r.Preferred_Name__c,Role_Start__c,Role_End__c,Period_Start__c,Role__c,Work_Unit__c,Planned_Hours__c,Planned_Cost__c,Allocation_Percent__c FROM Budget_Line__c WHERE Budget__c=:budgetId WITH USER_MODE ORDER BY Period_Start__c,Role__c];
        Map<Date,Map<String,Decimal>>months=new Map<Date,Map<String,Decimal>>();List<Map<String,Object>>assurance=new List<Map<String,Object>>();Decimal standardHours=Resource360Policy.numberValue('Budget_Standard_Monthly_Hours',160);for(Budget_Line__c line:lines){if(!months.containsKey(line.Period_Start__c))months.put(line.Period_Start__c,new Map<String,Decimal>{'plannedHours'=>0,'plannedCost'=>0,'actualHours'=>0});Map<String,Decimal>month=months.get(line.Period_Start__c);month.put('plannedHours',month.get('plannedHours')+value(line.Planned_Hours__c));month.put('plannedCost',month.get('plannedCost')+value(line.Planned_Cost__c));Decimal expected=standardHours*value(line.Allocation_Percent__c)/100;Boolean roleCoversMonth=(line.Role_Start__c==null||line.Role_Start__c<=line.Period_Start__c.toStartOfMonth().addMonths(1).addDays(-1))&&(line.Role_End__c==null||line.Role_End__c>=line.Period_Start__c);assurance.add(new Map<String,Object>{'lineId'=>line.Id,'period'=>line.Period_Start__c,'resource'=>line.Resource__r==null?'Role placeholder':line.Resource__r.Preferred_Name__c,'role'=>line.Role__c,'plannedHours'=>line.Planned_Hours__c,'allocationPercent'=>line.Allocation_Percent__c,'standardHoursAtAllocation'=>expected.setScale(2),'varianceFromStandardHours'=>(value(line.Planned_Hours__c)-expected).setScale(2),'roleWindowCoversMonth'=>roleCoversMonth,'state'=>roleCoversMonth?'Ready':'Role date exception'});}
        for(AggregateResult row:[SELECT CALENDAR_YEAR(Work_Date__c) year,CALENDAR_MONTH(Work_Date__c) month,SUM(Hours__c) hours FROM Time_Entry__c WHERE Engagement__c=:budget.Engagement__c AND State__c='Approved' AND Work_Date__c<=:cutoff WITH USER_MODE GROUP BY CALENDAR_YEAR(Work_Date__c),CALENDAR_MONTH(Work_Date__c)]){Date period=Date.newInstance(Integer.valueOf(row.get('year')),Integer.valueOf(row.get('month')),1);if(!months.containsKey(period))months.put(period,new Map<String,Decimal>{'plannedHours'=>0,'plannedCost'=>0,'actualHours'=>0});months.get(period).put('actualHours',value((Decimal)row.get('hours')));}

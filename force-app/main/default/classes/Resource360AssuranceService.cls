        Decimal averageRate=0;Decimal plannedHours=0;Decimal plannedCost=0;for(Budget_Line__c line:lines){plannedHours+=value(line.Planned_Hours__c);plannedCost+=value(line.Planned_Cost__c);}if(plannedHours>0)averageRate=plannedCost/plannedHours;Decimal actualCost=actualHours*averageRate;Decimal eac=actualCost+remainingCost;return JSON.serialize(new Map<String,Object>{'mock'=>true,'asOfDate'=>cutoff,'budgetId'=>budget.Id,'engagement'=>budget.Engagement__r.Name,'version'=>budget.Version__c,'state'=>budget.State__c,'monthlyGrid'=>grid,'rosterAssurance'=>assurance,'actualHours'=>actualHours,'actualCostAtBlendedBudgetRate'=>actualCost.setScale(2),'remainingPlannedCost'=>remainingCost,'estimateAtCompletion'=>eac.setScale(2),'forecastMarginPercent'=>budget.Revenue__c==null||budget.Revenue__c==0?0:((budget.Revenue__c-eac)/budget.Revenue__c*100).setScale(1),'assumption'=>'Actual cost uses the selected version blended budget rate in this sanitized mock baseline.'});

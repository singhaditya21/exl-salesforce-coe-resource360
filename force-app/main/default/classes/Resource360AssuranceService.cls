    private static List<Map<String,Object>>timeExceptions(){List<Map<String,Object>>rows=new List<Map<String,Object>>();for(Timesheet__c sheet:[SELECT Id,Name,Resource__r.Preferred_Name__c,Week_Start__c,Status__c,Due_At__c,Decision_Due_At__c,Exception_Code__c,Correction_Parent__c,Dual_Control_Required__c,Required_Approval_Role__c FROM Timesheet__c WHERE Current__c=true WITH USER_MODE ORDER BY Week_Start__c DESC LIMIT 100]){List<String>reasons=new List<String>();if(sheet.Status__c=='Draft'&&sheet.Due_At__c!=null&&sheet.Due_At__c<System.now())reasons.add('Submission overdue');if(sheet.Status__c=='Submitted'&&sheet.Decision_Due_At__c!=null&&sheet.Decision_Due_At__c<System.now())reasons.add('Decision overdue');if(String.isNotBlank(sheet.Exception_Code__c))reasons.add(sheet.Exception_Code__c);if(sheet.Correction_Parent__c!=null&&sheet.Dual_Control_Required__c==true)reasons.add('Controlled correction · '+sheet.Required_Approval_Role__c);if(!reasons.isEmpty())rows.add(new Map<String,Object>{'timesheetId'=>sheet.Id,'timesheet'=>sheet.Name,'resource'=>sheet.Resource__r.Preferred_Name__c,'weekStart'=>sheet.Week_Start__c,'status'=>sheet.Status__c,'reasons'=>reasons});}return rows;}
    private static List<Map<String,Object>>hierarchy(){Date today=Date.today();Map<String,Map<String,Decimal>>totals=new Map<String,Map<String,Decimal>>();for(Allocation__c allocation:[SELECT Engagement__r.Portfolio_ID__c,Engagement__r.Salesforce_Tower__c,Daily_Hours__c,Billable_Snapshot__c,Classification__c FROM Allocation__c WHERE State__c='Accepted' AND Current__c=true AND Start_Date__c<=:today AND End_Date__c>=:today WITH USER_MODE]){String key=(String.isBlank(allocation.Engagement__r.Portfolio_ID__c)?'Unassigned portfolio':allocation.Engagement__r.Portfolio_ID__c)+' / '+(String.isBlank(allocation.Engagement__r.Salesforce_Tower__c)?'Unassigned tower':allocation.Engagement__r.Salesforce_Tower__c);if(!totals.containsKey(key))totals.put(key,new Map<String,Decimal>{'totalHours'=>0,'billableHours'=>0,'warHours'=>0});Map<String,Decimal>item=totals.get(key);Decimal hours=value(allocation.Daily_Hours__c);item.put('totalHours',item.get('totalHours')+hours);if(allocation.Billable_Snapshot__c==true)item.put('billableHours',item.get('billableHours')+hours);if(allocation.Classification__c=='WAR')item.put('warHours',item.get('warHours')+hours);}List<Map<String,Object>>rows=new List<Map<String,Object>>();for(String key:totals.keySet()){Map<String,Decimal>item=totals.get(key);rows.add(new Map<String,Object>{'path'=>key,'totalDailyHours'=>item.get('totalHours'),'billableDailyHours'=>item.get('billableHours'),'warDailyHours'=>item.get('warHours'),'billingMixPercent'=>item.get('totalHours')==0?0:(item.get('billableHours')/item.get('totalHours')*100).setScale(1)});}return rows;}
    private static Map<String,Object>retentionPreviewMap(){Integer auditDays=Integer.valueOf(Resource360Policy.numberValue('Audit_Retention_Days',2555));Integer businessDays=Integer.valueOf(Resource360Policy.numberValue('Business_History_Retention_Days',2555));Boolean hold=Resource360Policy.booleanValue('Retention_Legal_Hold',false);DateTime auditCutoff=System.now().addDays(-auditDays);DateTime businessCutoff=System.now().addDays(-businessDays);Integer auditCandidates=Resource360Security.hasPermission('Resource360_View_Audit')?[SELECT COUNT() FROM R360_Audit_Event__c WHERE Occurred_At__c<:auditCutoff WITH USER_MODE]:0;Integer runCandidates=Resource360Security.hasPermission('Resource360_View_Operations')?[SELECT COUNT() FROM R360_Integration_Run__c WHERE Completed_At__c<:businessCutoff WITH USER_MODE]:0;return new Map<String,Object>{'mock'=>true,'decisionId'=>'R360-MOCK-ACTIVATION-2026-08-24','legalHold'=>hold,'auditRetentionDays'=>auditDays,'businessHistoryRetentionDays'=>businessDays,'auditCandidateCount'=>auditCandidates,'integrationRunCandidateCount'=>runCandidates,'rules'=>Resource360GovernanceService.retentionRules(),'executionMode'=>'Approved mock dry run only','deletionAllowed'=>false,'approvalStatus'=>'Approved mock assumption','notice'=>'The mock retention schedule is approved and testable; destructive production disposition remains disabled until an EXL release supplies legal-hold and recovery evidence.'};}
    private static Integer businessDays(Date startDate,Date endDate){if(endDate<startDate)return 0;Integer count=0;for(Date cursor=startDate;cursor<=endDate;cursor=cursor.addDays(1)){Integer weekday=Math.mod(Date.newInstance(1900,1,1).daysBetween(cursor),7)+1;if(weekday<=5)count++;}return count;}
    private static Decimal value(Decimal input){return input==null?0:input;}private static Decimal decimalValue(Object input,Decimal fallback){return input==null?fallback:Decimal.valueOf(String.valueOf(input));}private static Date parseDate(Object input,Date fallback){return input==null||String.isBlank(String.valueOf(input))?fallback:Date.valueOf(String.valueOf(input));}private static String truncate(String value,Integer size){return value!=null&&value.length()>size?value.substring(0,size):value;}private static String correlationId(){return EncodingUtil.convertToHex(Crypto.generateAesKey(128));}private static Resource360Service.ServiceResult result(Boolean success,String message,Id recordId,String correlation){return new Resource360Service.ServiceResult(success,message,recordId,correlation);}private static void fail(String message){throw new AuraHandledException(message);}

public inherited sharing class Resource360TalentService {
    public class CapabilityRequirement { public Id capabilityId;public Integer minimumLevel;public Boolean mandatory; }
    public class SearchCriteria { public String mode;public List<CapabilityRequirement> capabilityRequirements;public List<String> mandatoryCredentials;public List<String> preferredCredentials;public String requestedRole;public String industry;public String tower;public String location;public Date startDate;public Date endDate;public Decimal dailyHours;public Decimal minimumExperience;public Integer requestedLimit; }
    public class Candidate {
        @AuraEnabled public Id resourceId;@AuraEnabled public String employeeId;@AuraEnabled public String name;@AuraEnabled public String role;@AuraEnabled public String tower;@AuraEnabled public String location;@AuraEnabled public Decimal availablePercent;@AuraEnabled public Integer approvedLevel;@AuraEnabled public Decimal yearsExperience;@AuraEnabled public Decimal score;@AuraEnabled public String explanation;@AuraEnabled public Boolean eligible;
    }

    @AuraEnabled(cacheable=true)
    public static List<Candidate> searchCandidates(Id capabilityId,Integer minimumLevel,String requestedRole,Date startDate,Date endDate,Decimal dailyHours,String tower,String location,Integer requestedLimit){
        SearchCriteria criteria=new SearchCriteria();criteria.mode='filter';criteria.requestedRole=requestedRole;criteria.startDate=startDate;criteria.endDate=endDate;criteria.dailyHours=dailyHours;criteria.tower=tower;criteria.location=location;criteria.requestedLimit=requestedLimit;
        if(capabilityId!=null){CapabilityRequirement requirement=new CapabilityRequirement();requirement.capabilityId=capabilityId;requirement.minimumLevel=minimumLevel==null?1:minimumLevel;requirement.mandatory=true;criteria.capabilityRequirements=new List<CapabilityRequirement>{requirement};}
        return execute(criteria,false);
    }

    @AuraEnabled(cacheable=true)
    public static List<Candidate> searchCandidatesV2(String criteriaJson){if(String.isBlank(criteriaJson))fail('A versioned talent-search requirement body is required.');SearchCriteria criteria=(SearchCriteria)JSON.deserialize(criteriaJson,SearchCriteria.class);return execute(criteria,true);}

    private static List<Candidate>execute(SearchCriteria criteria,Boolean rejectEmpty){
        if(criteria==null||criteria.startDate==null||criteria.endDate==null||criteria.endDate<criteria.startDate)fail('Provide a valid candidate search date range.');
        if(criteria.dailyHours!=null&&(criteria.dailyHours<=0||criteria.dailyHours>24))fail('Requested daily hours must be between 0 and 24.');
        if(criteria.minimumExperience!=null&&(criteria.minimumExperience<0||criteria.minimumExperience>50))fail('Minimum experience must be between 0 and 50 years.');
        if(criteria.capabilityRequirements==null)criteria.capabilityRequirements=new List<CapabilityRequirement>();if(criteria.mandatoryCredentials==null)criteria.mandatoryCredentials=new List<String>();if(criteria.preferredCredentials==null)criteria.preferredCredentials=new List<String>();
        if(rejectEmpty&&criteria.capabilityRequirements.isEmpty()&&criteria.mandatoryCredentials.isEmpty()&&criteria.preferredCredentials.isEmpty()&&String.isBlank(criteria.requestedRole)&&String.isBlank(criteria.industry)&&String.isBlank(criteria.tower)&&String.isBlank(criteria.location)&&criteria.minimumExperience==null)fail('Add at least one governed talent requirement.');
        for(CapabilityRequirement requirement:criteria.capabilityRequirements)if(requirement.capabilityId==null||requirement.minimumLevel==null||requirement.minimumLevel<1||requirement.minimumLevel>4)fail('Every capability requirement needs a capability and minimum level from 1 to 4.');
        Integer rowLimit=criteria.requestedLimit==null?50:Math.min(Math.max(criteria.requestedLimit,1),100);String mode=String.isBlank(criteria.mode)?'filter':criteria.mode.toLowerCase();if(mode!='filter'&&mode!='rank')fail('Talent search mode must be filter or rank.');
        String query='SELECT Id,Employee_ID__c,Preferred_Name__c,Primary_Role__c,Tower__c,Location__c,Available_Percent__c,Employment_Start__c,Employment_End__c,'+
            '(SELECT Capability__c,Approved_Level__c,Years_Experience__c,Last_Used__c FROM Skill_Claims__r WHERE State__c=\'Approved\'),'+
            '(SELECT Credential_Name__c,State__c,Expiry_Date__c FROM Credentials__r WHERE State__c=\'Verified\'),'+
            '(SELECT Capability__c,Role__c,Start_Date__c,End_Date__c,State__c,Engagement__r.Industry__c FROM Project_Evidence__r WHERE State__c=\'Verified\') '+
            'FROM Resource__c WHERE Status__c=\'Active\' AND(Employment_Start__c=null OR Employment_Start__c<=:startDate) AND(Employment_End__c=null OR Employment_End__c>=:endDate)';
        Map<String,Object>binds=new Map<String,Object>{'startDate'=>criteria.startDate,'endDate'=>criteria.endDate,'rowLimit'=>rowLimit};if(String.isNotBlank(criteria.tower)){query+=' AND Tower__c=:tower';binds.put('tower',criteria.tower);}if(String.isNotBlank(criteria.location)){query+=' AND Location__c=:location';binds.put('location',criteria.location);}query+=' ORDER BY Available_Percent__c DESC NULLS LAST LIMIT :rowLimit';
        List<Candidate>results=new List<Candidate>();Date today=Date.today();Decimal requiredAvailability=criteria.dailyHours==null?0:(criteria.dailyHours/Resource360Policy.numberValue('Default_Daily_Capacity',8)*100);
        for(SObject rawResource:Database.queryWithBinds(query,binds,AccessLevel.USER_MODE)){Resource__c resource=(Resource__c)rawResource;
            Map<Id,Skill_Claim__c>bestClaims=new Map<Id,Skill_Claim__c>();for(Skill_Claim__c claim:resource.Skill_Claims__r)if(!bestClaims.containsKey(claim.Capability__c)||claim.Approved_Level__c>bestClaims.get(claim.Capability__c).Approved_Level__c)bestClaims.put(claim.Capability__c,claim);
            Boolean hardGate=true;Decimal capabilityRatio=0;Integer mandatoryLevel=0;Decimal relevantExperience=0;for(CapabilityRequirement requirement:criteria.capabilityRequirements){Skill_Claim__c claim=bestClaims.get(requirement.capabilityId);Decimal actual=claim==null||claim.Approved_Level__c==null?0:claim.Approved_Level__c;Decimal ratio=Math.min(actual/requirement.minimumLevel,1);capabilityRatio+=ratio;if(requirement.mandatory==true&&ratio<1)hardGate=false;if(claim!=null){mandatoryLevel=Math.max(mandatoryLevel,Integer.valueOf(claim.Approved_Level__c));relevantExperience=Math.max(relevantExperience,claim.Years_Experience__c==null?0:claim.Years_Experience__c);}}
            if(!criteria.capabilityRequirements.isEmpty())capabilityRatio/=criteria.capabilityRequirements.size();
            List<Credential__c>activeCredentials=new List<Credential__c>();for(Credential__c credential:resource.Credentials__r)if(credential.Expiry_Date__c==null||credential.Expiry_Date__c>=today)activeCredentials.add(credential);
            for(String required:criteria.mandatoryCredentials)if(!hasCredential(activeCredentials,required))hardGate=false;
            Decimal preferredRatio=0;if(!criteria.preferredCredentials.isEmpty()){for(String preferred:criteria.preferredCredentials)if(hasCredential(activeCredentials,preferred))preferredRatio++;preferredRatio/=criteria.preferredCredentials.size();}
            Decimal projectRatio=0;Decimal industryRatio=0;for(R360_Project_Evidence__c evidence:resource.Project_Evidence__r){Boolean relevantCapability=criteria.capabilityRequirements.isEmpty();for(CapabilityRequirement requirement:criteria.capabilityRequirements)if(requirement.capabilityId==evidence.Capability__c)relevantCapability=true;Boolean relevantRole=String.isBlank(criteria.requestedRole)||(String.isNotBlank(evidence.Role__c)&&evidence.Role__c.toLowerCase().contains(criteria.requestedRole.toLowerCase()));if(relevantCapability&&relevantRole){Integer ageDays=evidence.End_Date__c.daysBetween(today);Decimal recency=ageDays<=365?1:ageDays<=730?0.75:ageDays<=1095?0.4:0.1;Decimal duration=Math.min((evidence.Start_Date__c.daysBetween(evidence.End_Date__c)+1)/365.0,1);projectRatio=Math.max(projectRatio,(recency+duration)/2);}if(String.isNotBlank(criteria.industry)&&evidence.Engagement__r!=null&&criteria.industry==evidence.Engagement__r.Industry__c)industryRatio=1;}
            Decimal experienceDenominator=(criteria.minimumExperience==null||criteria.minimumExperience==0)?10.0:criteria.minimumExperience;Decimal experienceRatio=Math.min(relevantExperience/experienceDenominator,1);if(criteria.minimumExperience!=null&&relevantExperience<criteria.minimumExperience)hardGate=false;
            Decimal available=resource.Available_Percent__c==null?0:resource.Available_Percent__c;Decimal availabilityRatio=requiredAvailability==0?Math.min(available/100,1):Math.min(available/requiredAvailability,1);if(available<requiredAvailability)hardGate=false;
            if(mode=='filter'&&!hardGate)continue;if(mode=='rank'&&!criteria.capabilityRequirements.isEmpty()){Boolean holdsAny=false;for(CapabilityRequirement requirement:criteria.capabilityRequirements)if(bestClaims.containsKey(requirement.capabilityId))holdsAny=true;if(!holdsAny)continue;}
            Decimal capabilityScore=capabilityRatio*35,projectScore=projectRatio*20,industryScore=industryRatio*15,credentialScore=preferredRatio*10,experienceScore=experienceRatio*10,availabilityScore=availabilityRatio*10;
            Candidate candidate=new Candidate();candidate.resourceId=resource.Id;candidate.employeeId=resource.Employee_ID__c;candidate.name=resource.Preferred_Name__c;candidate.role=resource.Primary_Role__c;candidate.tower=resource.Tower__c;candidate.location=resource.Location__c;candidate.availablePercent=available;candidate.approvedLevel=mandatoryLevel;candidate.yearsExperience=relevantExperience;candidate.score=(capabilityScore+projectScore+industryScore+credentialScore+experienceScore+availabilityScore).setScale(1);candidate.eligible=hardGate;candidate.explanation='Resource360 fit policy v1 · capability '+capabilityScore.setScale(1)+'/35; project evidence '+projectScore.setScale(1)+'/20; industry '+industryScore.setScale(1)+'/15; preferred credentials '+credentialScore.setScale(1)+'/10; experience '+experienceScore.setScale(1)+'/10; availability '+availabilityScore.setScale(1)+'/10; hard gates '+(hardGate?'passed':'not met')+'.';results.add(candidate);
        }
        results.sort(new CandidateComparator());return results;
    }
    private static Boolean hasCredential(List<Credential__c>credentials,String requirement){if(String.isBlank(requirement))return true;for(Credential__c credential:credentials)if(String.isNotBlank(credential.Credential_Name__c)&&credential.Credential_Name__c.toLowerCase().contains(requirement.toLowerCase()))return true;return false;}
    private class CandidateComparator implements Comparator<Candidate>{public Integer compare(Candidate left,Candidate right){if(left.score==right.score)return left.name.toLowerCase().compareTo(right.name.toLowerCase());return left.score>right.score?-1:1;}}
    private static void fail(String message){throw new AuraHandledException(message);}
}

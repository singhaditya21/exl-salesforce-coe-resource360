public inherited sharing class Resource360AnalyticsService {
    public static Map<String,Object> snapshot(){
        Date asOf=Date.today();Integer actualsWindow=Integer.valueOf(Resource360Policy.numberValue('KPI_Actuals_Window_Days',30));Integer staffingWindow=Integer.valueOf(Resource360Policy.numberValue('KPI_Staffing_Window_Days',90));Date actualsFrom=asOf.addDays(1-actualsWindow);DateTime staffingFrom=System.now().addDays(-staffingWindow);
        List<Resource__c>resources=[SELECT Id,Daily_Capacity_Hours__c,Available_Percent__c FROM Resource__c WHERE Status__c='Active' WITH USER_MODE];
        Decimal nominalCapacity=0;Decimal statedAvailablePercent=0;for(Resource__c resource:resources){nominalCapacity+=resource.Daily_Capacity_Hours__c==null?Resource360Policy.numberValue('Default_Daily_Capacity',8):resource.Daily_Capacity_Hours__c;statedAvailablePercent+=resource.Available_Percent__c==null?0:resource.Available_Percent__c;}
        List<Allocation__c>allocations=[SELECT Id,Daily_Hours__c,Billable_Snapshot__c,Classification__c FROM Allocation__c WHERE State__c='Accepted' AND Current__c=true AND Start_Date__c<=:asOf AND End_Date__c>=:asOf WITH USER_MODE];
        Decimal committedHours=0;Decimal billedHours=0;Decimal unbilledHours=0;Decimal warHours=0;Decimal ifbHours=0;for(Allocation__c allocation:allocations){Decimal hours=allocation.Daily_Hours__c==null?0:allocation.Daily_Hours__c;committedHours+=hours;if(allocation.Billable_Snapshot__c==true)billedHours+=hours;else unbilledHours+=hours;if(allocation.Classification__c=='WAR')warHours+=hours;if(allocation.Classification__c=='IFB/PO Awaited')ifbHours+=hours;}
        List<Staffing_Request__c>requests=[SELECT State__c,SLA_Due__c FROM Staffing_Request__c WHERE CreatedDate>=:staffingFrom WITH USER_MODE];Map<String,Integer>requestCounts=counts(requests,'State__c');Integer overdueStaffing=0;for(Staffing_Request__c request:requests)if(request.State__c=='Pending'&&request.SLA_Due__c!=null&&request.SLA_Due__c<System.now())overdueStaffing++;
        List<Budget__c>budgets=[SELECT State__c,Revenue__c,Total_Cost__c,Gross_Margin__c,Margin_Percent__c FROM Budget__c WHERE Current__c=true WITH USER_MODE];Decimal approvedRevenue=0;Decimal approvedCost=0;Decimal approvedMargin=0;Integer approvedBudgets=0;for(Budget__c budget:budgets)if(budget.State__c=='Approved'){approvedBudgets++;approvedRevenue+=value(budget.Revenue__c);approvedCost+=value(budget.Total_Cost__c);approvedMargin+=value(budget.Gross_Margin__c);}
        List<Time_Entry__c>actuals=[SELECT Hours__c FROM Time_Entry__c WHERE State__c='Approved' AND Work_Date__c>=:actualsFrom AND Work_Date__c<=:asOf WITH USER_MODE];Decimal approvedActualHours=0;for(Time_Entry__c entry:actuals)approvedActualHours+=value(entry.Hours__c);
        Integer approvedCapabilities=[SELECT COUNT() FROM Skill_Claim__c WHERE State__c='Approved' WITH USER_MODE];Integer verifiedCredentials=[SELECT COUNT() FROM Credential__c WHERE State__c='Verified' AND(Expiry_Date__c=null OR Expiry_Date__c>=:asOf) WITH USER_MODE];Integer overdueTimesheets=[SELECT COUNT() FROM Timesheet__c WHERE Status__c='Submitted' AND Decision_Due_At__c<=:System.now() WITH USER_MODE];Integer syncErrors=Resource360Security.hasPermission('Resource360_View_Operations')?[SELECT COUNT() FROM R360_Integration_Error__c WHERE State__c IN('Retry Pending','Dead Letter') WITH USER_MODE]:0;
        Decimal utilization=nominalCapacity==0?0:(committedHours/nominalCapacity*100).setScale(1);Decimal billingMix=committedHours==0?0:(billedHours/committedHours*100).setScale(1);Decimal warPercent=nominalCapacity==0?0:(warHours/nominalCapacity*100).setScale(1);Decimal ifbPercent=nominalCapacity==0?0:(ifbHours/nominalCapacity*100).setScale(1);Decimal weightedMargin=approvedRevenue==0?0:(approvedMargin/approvedRevenue*100).setScale(1);
        Map<String,Object>targets=new Map<String,Object>{'billedUtilizationPercent'=>Resource360Policy.numberValue('KPI_Billed_Target_Percent',75),'warMaximumPercent'=>Resource360Policy.numberValue('KPI_WAR_Max_Percent',10),'ifbMaximumPercent'=>Resource360Policy.numberValue('KPI_IFB_Max_Percent',2)};return new Map<String,Object>{
            'asOfDate'=>asOf,'generatedAt'=>System.now(),'actualsFrom'=>actualsFrom,'currency'=>'INR','population'=>'Records visible to the running user under Salesforce sharing and field permissions',
            'activeHeadcount'=>resources.size(),'nominalDailyCapacityHours'=>nominalCapacity,'committedDailyHours'=>committedHours,'utilizationPercent'=>utilization,'billingMixPercent'=>billingMix,'warPercent'=>warPercent,'ifbPercent'=>ifbPercent,'unbilledDailyHours'=>unbilledHours,'averageStatedAvailabilityPercent'=>resources.isEmpty()?0:(statedAvailablePercent/resources.size()).setScale(1),
            'pendingStaffing'=>requestCounts.containsKey('Pending')?requestCounts.get('Pending'):0,'acceptedStaffing90Days'=>requestCounts.containsKey('Accepted')?requestCounts.get('Accepted'):0,'declinedStaffing90Days'=>requestCounts.containsKey('Declined')?requestCounts.get('Declined'):0,'expiredStaffing90Days'=>requestCounts.containsKey('Expired')?requestCounts.get('Expired'):0,'overdueStaffing'=>overdueStaffing,
            'approvedBudgetCount'=>approvedBudgets,'approvedRevenue'=>approvedRevenue,'approvedCost'=>approvedCost,'approvedGrossMargin'=>approvedMargin,'approvedMarginPercent'=>weightedMargin,'approvedActualHours30Days'=>approvedActualHours,
            'approvedCapabilityClaims'=>approvedCapabilities,'activeVerifiedCredentials'=>verifiedCredentials,'overdueTimesheets'=>overdueTimesheets,'openIntegrationErrors'=>syncErrors,'targets'=>targets,'actualsWindowDays'=>actualsWindow,'staffingWindowDays'=>staffingWindow,
            'definitions'=>new Map<String,Object>{'utilizationPercent'=>'Current accepted daily allocation hours divided by nominal active-resource daily capacity on the as-of date.','billingMixPercent'=>'Current billable-snapshot allocation hours divided by all current accepted allocation hours.','warPercent'=>'Current WAR daily hours divided by nominal active-resource daily capacity.','ifbPercent'=>'Current IFB/PO Awaited daily hours divided by nominal active-resource daily capacity.','approvedMarginPercent'=>'Approved gross margin divided by approved revenue across current approved budgets.','approvedActualHours30Days'=>'Approved time-entry hours in the configured inclusive '+actualsWindow+'-day window.','staffingWindow'=>'Staffing lifecycle counts in the configured '+staffingWindow+'-day window.'}
        };
    }
    private static Map<String,Integer>counts(List<Staffing_Request__c>records,String field){Map<String,Integer>result=new Map<String,Integer>();for(Staffing_Request__c record:records){String key=String.valueOf(record.get(field));result.put(key,(result.containsKey(key)?result.get(key):0)+1);}return result;}
    private static Decimal value(Decimal input){return input==null?0:input;}
}

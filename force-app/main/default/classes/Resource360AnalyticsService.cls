public inherited sharing class Resource360AnalyticsService {
    public static Map<String,Object> snapshot(){
        Date asOf=Date.today();Date next90=asOf.addDays(90);Date next13Weeks=asOf.addDays(91);Integer actualsWindow=Integer.valueOf(Resource360Policy.numberValue('KPI_Actuals_Window_Days',30));Integer staffingWindow=Integer.valueOf(Resource360Policy.numberValue('KPI_Staffing_Window_Days',90));Date actualsFrom=asOf.addDays(1-actualsWindow);DateTime staffingFrom=System.now().addDays(-staffingWindow);
        List<Resource__c>resources=[SELECT Id,Daily_Capacity_Hours__c,Available_Percent__c,Allocated_Daily_Hours__c,Capacity_Status__c,Capacity_As_Of__c,Overallocated__c FROM Resource__c WHERE Status__c='Active' WITH USER_MODE];
        Decimal nominalCapacity=0;Decimal statedAvailablePercent=0;for(Resource__c resource:resources){nominalCapacity+=resource.Daily_Capacity_Hours__c==null?Resource360Policy.numberValue('Default_Daily_Capacity',8):resource.Daily_Capacity_Hours__c;statedAvailablePercent+=value(resource.Available_Percent__c);}
        List<Allocation__c>allocations=[SELECT Id,Daily_Hours__c,Billable_Snapshot__c,Classification__c FROM Allocation__c WHERE State__c='Accepted' AND Current__c=true AND Start_Date__c<=:asOf AND End_Date__c>=:asOf WITH USER_MODE];
        Decimal allocationHours=0;Decimal billedHours=0;Decimal unbilledHours=0;Decimal warHours=0;Decimal ifbHours=0;for(Allocation__c allocation:allocations){Decimal hours=value(allocation.Daily_Hours__c);allocationHours+=hours;if(allocation.Billable_Snapshot__c==true)billedHours+=hours;else unbilledHours+=hours;if(allocation.Classification__c=='WAR')warHours+=hours;if(allocation.Classification__c=='IFB/PO Awaited')ifbHours+=hours;}
        List<Staffing_Request__c>requests=[SELECT State__c,SLA_Due__c FROM Staffing_Request__c WHERE CreatedDate>=:staffingFrom WITH USER_MODE];Map<String,Integer>requestCounts=counts(requests,'State__c');Integer overdueStaffing=0;for(Staffing_Request__c request:requests)if(request.State__c=='Pending'&&request.SLA_Due__c!=null&&request.SLA_Due__c<System.now())overdueStaffing++;
        List<Budget__c>budgets=[SELECT State__c,Revenue__c,Total_Cost__c,Gross_Margin__c,Margin_Percent__c FROM Budget__c WHERE Current__c=true WITH USER_MODE];Decimal approvedRevenue=0;Decimal approvedCost=0;Decimal approvedMargin=0;Integer approvedBudgets=0;for(Budget__c budget:budgets)if(budget.State__c=='Approved'){approvedBudgets++;approvedRevenue+=value(budget.Revenue__c);approvedCost+=value(budget.Total_Cost__c);approvedMargin+=value(budget.Gross_Margin__c);}
        List<Time_Entry__c>actuals=[SELECT Hours__c,Work_Date__c,Timesheet__r.Resource__c FROM Time_Entry__c WHERE State__c='Approved' AND Work_Date__c>=:actualsFrom AND Work_Date__c<=:asOf WITH USER_MODE];Decimal approvedActualHours=0;Map<String,Decimal>actualHoursByDay=new Map<String,Decimal>();for(Time_Entry__c entry:actuals){approvedActualHours+=value(entry.Hours__c);String key=String.valueOf(entry.Timesheet__r.Resource__c)+'|'+String.valueOf(entry.Work_Date__c);actualHoursByDay.put(key,(actualHoursByDay.containsKey(key)?actualHoursByDay.get(key):0)+value(entry.Hours__c));}Integer actualTimeBreaches=0;Decimal actualMaximum=Resource360Policy.numberValue('Time_Max_Daily_Hours',8);for(Decimal daily:actualHoursByDay.values())if(daily>actualMaximum)actualTimeBreaches++;
        Integer approvedCapabilities=[SELECT COUNT() FROM Skill_Claim__c WHERE State__c='Approved' WITH USER_MODE];Integer verifiedCredentials=[SELECT COUNT() FROM Credential__c WHERE State__c='Verified' AND(Expiry_Date__c=null OR Expiry_Date__c>=:asOf) WITH USER_MODE];Integer credentialsAtRisk=[SELECT COUNT() FROM Credential__c WHERE State__c='Verified' AND Expiry_Date__c>=:asOf AND Expiry_Date__c<=:next90 WITH USER_MODE];Integer overdueTimesheets=[SELECT COUNT() FROM Timesheet__c WHERE Status__c='Submitted' AND Decision_Due_At__c<=:System.now() WITH USER_MODE];Integer syncErrors=Resource360Security.hasPermission('Resource360_View_Operations')?[SELECT COUNT() FROM R360_Integration_Error__c WHERE State__c IN('Retry Pending','Dead Letter') WITH USER_MODE]:0;
        Map<String,Decimal>certifiedKpis=new Map<String,Decimal>();for(R360_KPI_Snapshot__c item:[SELECT Metric_Code__c,Metric_Value__c FROM R360_KPI_Snapshot__c WHERE Forecast__c=false AND Scope_Type__c='Enterprise' AND Snapshot_Date__c<=:asOf WITH USER_MODE ORDER BY Snapshot_Date__c DESC LIMIT 100])if(!certifiedKpis.containsKey(item.Metric_Code__c))certifiedKpis.put(item.Metric_Code__c,value(item.Metric_Value__c));
        Decimal forecastCoverageMinimum=null;Integer forecastWeeks=0;for(R360_KPI_Snapshot__c item:[SELECT Metric_Value__c FROM R360_KPI_Snapshot__c WHERE Metric_Code__c='CAPACITY_COVERAGE_13W' AND Forecast__c=true AND Snapshot_Date__c>=:asOf WITH USER_MODE ORDER BY Snapshot_Date__c LIMIT 13]){forecastWeeks++;Decimal current=value(item.Metric_Value__c);forecastCoverageMinimum=forecastCoverageMinimum==null?current:Math.min(forecastCoverageMinimum,current);}Integer upcomingUnavailability=[SELECT COUNT() FROM R360_Resource_Unavailability__c WHERE Status__c='Approved' AND End_Date__c>=:asOf AND Start_Date__c<=:next13Weeks WITH USER_MODE];

        List<R360_Daily_Capacity__c>ledger=[SELECT Resource__c,Work_Date__c,Standard_Hours__c,Allocated_Hours__c,Remaining_Hours__c,Overage_Hours__c,Utilization_Percent__c,Capacity_Status__c,Allocation_Count__c,Approved_Overallocated__c,Pending_Approval_Count__c,Reconciled_At__c FROM R360_Daily_Capacity__c WHERE Work_Date__c=:asOf WITH USER_MODE];
        Integer underallocated=0;Integer fullyAllocated=0;Integer overallocated=0;Integer approvedOverallocated=0;Integer unapprovedOverallocated=0;Integer hardCeilingBreaches=0;Integer pendingOverallocation=0;Decimal totalOverageHours=0;Decimal ledgerAllocatedHours=0;
        for(R360_Daily_Capacity__c row:ledger){Decimal hours=value(row.Allocated_Hours__c);ledgerAllocatedHours+=hours;pendingOverallocation+=Integer.valueOf(String.valueOf(value(row.Pending_Approval_Count__c).setScale(0)));if(hours<8)underallocated++;else if(hours==8)fullyAllocated++;else{overallocated++;totalOverageHours+=value(row.Overage_Hours__c);if(row.Approved_Overallocated__c)approvedOverallocated++;else unapprovedOverallocated++;if(hours>Resource360CapacityService.safetyCeiling())hardCeilingBreaches++;}}
        Integer population=ledger.size();Integer atLeastEight=fullyAllocated+overallocated;Decimal fullCoverage=percent(atLeastEight,population);Decimal balanced=percent(fullyAllocated,population);Decimal overallocatedShare=percent(overallocated,population);
        Decimal utilization=nominalCapacity==0?0:(ledgerAllocatedHours/nominalCapacity*100).setScale(1);Decimal billingMix=allocationHours==0?0:(billedHours/allocationHours*100).setScale(1);Decimal warPercent=nominalCapacity==0?0:(warHours/nominalCapacity*100).setScale(1);Decimal ifbPercent=nominalCapacity==0?0:(ifbHours/nominalCapacity*100).setScale(1);Decimal weightedMargin=approvedRevenue==0?0:(approvedMargin/approvedRevenue*100).setScale(1);
        Map<String,Object>targets=new Map<String,Object>{'billedUtilizationPercent'=>Resource360Policy.numberValue('KPI_Billed_Target_Percent',75),'warMaximumPercent'=>Resource360Policy.numberValue('KPI_WAR_Max_Percent',10),'ifbMaximumPercent'=>Resource360Policy.numberValue('KPI_IFB_Max_Percent',2),'fullAllocationCoveragePercent'=>Resource360Policy.numberValue('KPI_Full_Allocation_Coverage_Target',100),'overallocatedShareMaximumPercent'=>Resource360Policy.numberValue('KPI_Overallocated_Max_Percent',20),'pendingOverallocationMaximum'=>Resource360Policy.numberValue('KPI_Pending_Overallocation_Max',0),'hardCeilingBreaches'=>0,'unapprovedOverallocatedResources'=>0,'actualTimeBreaches'=>0};
        return new Map<String,Object>{
            'asOfDate'=>asOf,'generatedAt'=>System.now(),'actualsFrom'=>actualsFrom,'currency'=>'INR','population'=>'Records visible to the running user under Salesforce sharing and field permissions; capacity uses the reconciled current-day ledger',
            'activeHeadcount'=>resources.size(),'capacityLedgerPopulation'=>population,'nominalDailyCapacityHours'=>nominalCapacity,'committedDailyHours'=>ledgerAllocatedHours,'utilizationPercent'=>utilization,'billingMixPercent'=>billingMix,'warPercent'=>warPercent,'ifbPercent'=>ifbPercent,'unbilledDailyHours'=>unbilledHours,'averageStatedAvailabilityPercent'=>resources.isEmpty()?0:(statedAvailablePercent/resources.size()).setScale(1),
            'fullAllocationCoveragePercent'=>fullCoverage,'balancedCapacityPercent'=>balanced,'overallocatedSharePercent'=>overallocatedShare,'underallocatedResources'=>underallocated,'fullyAllocatedResources'=>fullyAllocated,'overallocatedResources'=>overallocated,'approvedOverallocatedResources'=>approvedOverallocated,'unapprovedOverallocatedResources'=>unapprovedOverallocated,'pendingOverallocationPlans'=>pendingOverallocation,'totalOverageHours'=>totalOverageHours,'hardCeilingBreaches'=>hardCeilingBreaches,'actualTimeBreaches'=>actualTimeBreaches,
            'pendingStaffing'=>requestCounts.containsKey('Pending')?requestCounts.get('Pending'):0,'capacityApprovalStaffing'=>requestCounts.containsKey('Capacity Approval')?requestCounts.get('Capacity Approval'):0,'acceptedStaffing90Days'=>requestCounts.containsKey('Accepted')?requestCounts.get('Accepted'):0,'declinedStaffing90Days'=>requestCounts.containsKey('Declined')?requestCounts.get('Declined'):0,'expiredStaffing90Days'=>requestCounts.containsKey('Expired')?requestCounts.get('Expired'):0,'overdueStaffing'=>overdueStaffing,
            'approvedBudgetCount'=>approvedBudgets,'approvedRevenue'=>approvedRevenue,'approvedCost'=>approvedCost,'approvedGrossMargin'=>approvedMargin,'approvedMarginPercent'=>weightedMargin,'approvedActualHours30Days'=>approvedActualHours,
            'approvedCapabilityClaims'=>approvedCapabilities,'activeVerifiedCredentials'=>verifiedCredentials,'credentialsAtRisk90Days'=>credentialsAtRisk,'overdueTimesheets'=>overdueTimesheets,'openIntegrationErrors'=>syncErrors,'upcomingUnavailabilityEvents13Weeks'=>upcomingUnavailability,'forecastWeeks'=>forecastWeeks,'capacityCoverage13WeekMinimumPercent'=>forecastCoverageMinimum==null?0:forecastCoverageMinimum,'demandFulfilmentPercent'=>kpi(certifiedKpis,'FULFILMENT_RATE'),'medianTimeToStaffDays'=>kpi(certifiedKpis,'TIME_TO_STAFF_DAYS'),'medianBenchAgeDays'=>kpi(certifiedKpis,'BENCH_AGE_DAYS'),'scheduleVarianceDays'=>kpi(certifiedKpis,'SCHEDULE_VARIANCE_DAYS'),'costPerformanceIndex'=>kpi(certifiedKpis,'CPI'),'marginErosionPoints'=>kpi(certifiedKpis,'MARGIN_EROSION_PTS'),'dataQualityScorePercent'=>kpi(certifiedKpis,'DATA_QUALITY_SCORE'),'targets'=>targets,'actualsWindowDays'=>actualsWindow,'staffingWindowDays'=>staffingWindow,
            'definitions'=>new Map<String,Object>{'fullAllocationCoveragePercent'=>'Active, visible resources with at least eight aggregate accepted allocation hours divided by the current daily-capacity ledger population.','balancedCapacityPercent'=>'Active, visible resources at exactly eight aggregate accepted hours divided by the current daily-capacity ledger population.','overallocatedSharePercent'=>'Active, visible resources above eight aggregate accepted hours divided by the current daily-capacity ledger population; only independently approved exceptions are compliant.','utilizationPercent'=>'Current ledger allocated hours divided by nominal active-resource daily capacity on the as-of date.','hardCeilingBreaches'=>'Current ledger rows above the configured twelve-hour safety ceiling; target is zero.','unapprovedOverallocatedResources'=>'Current overallocated ledger rows without active approval evidence; target is zero.','actualTimeBreaches'=>'Approved resource-date actual-time totals above the configured eight-hour cap in the actuals window; target is zero.','billingMixPercent'=>'Current billable-snapshot allocation hours divided by all current accepted allocation hours.','warPercent'=>'Current WAR daily hours divided by nominal active-resource daily capacity.','ifbPercent'=>'Current IFB/PO Awaited daily hours divided by nominal active-resource daily capacity.','approvedMarginPercent'=>'Approved gross margin divided by approved revenue across current approved budgets.','approvedActualHours30Days'=>'Approved time-entry hours in the configured inclusive '+actualsWindow+'-day window.','staffingWindow'=>'Staffing lifecycle counts in the configured '+staffingWindow+'-day window.'}
        };
    }
    private static Decimal percent(Integer numerator,Integer denominator){return denominator==0?0:(Decimal.valueOf(String.valueOf(numerator))/denominator*100).setScale(1);}
    private static Map<String,Integer>counts(List<Staffing_Request__c>records,String field){Map<String,Integer>result=new Map<String,Integer>();for(Staffing_Request__c record:records){String key=String.valueOf(record.get(field));result.put(key,(result.containsKey(key)?result.get(key):0)+1);}return result;}
    private static Decimal value(Decimal input){return input==null?0:input;}
    private static Decimal kpi(Map<String,Decimal> values,String code){return values.containsKey(code)?values.get(code):0;}
}

    private static void ensureMockSourceRuns(){
        Set<String>existing=new Set<String>();for(R360_Integration_Run__c run:[SELECT Run_ID__c FROM R360_Integration_Run__c WHERE Run_ID__c LIKE 'DEMO-SOURCE-%'])existing.add(run.Run_ID__c);List<R360_Integration_Run__c>runs=new List<R360_Integration_Run__c>();Integer index=0;for(List<String>definition:new List<List<String>>{new List<String>{'PEOPLE','People Master','Employee','1862','4'},new List<String>{'ENGAGEMENT','Engagement Master','Engagement','38','1'},new List<String>{'LEARNING','Learning Hub','LearningAchievement','299','82'},new List<String>{'CREDENTIAL','Credential Gateway','Credential','1284','11'},new List<String>{'COMMERCIAL','Commercial Master','CommercialReference','38','0'},new List<String>{'ORG','Org Hierarchy','OrgUnit','49','2'},new List<String>{'PORTFOLIO','Portfolio Master','Portfolio','8','0'}}){String runId='DEMO-SOURCE-'+definition[0];if(existing.contains(runId)){index++;continue;}Integer processed=Integer.valueOf(definition[3]),inserted=Integer.valueOf(definition[4]);DateTime cutoff=System.now().addMinutes(-index*7);runs.add(new R360_Integration_Run__c(Run_ID__c=runId,Source_System__c=definition[1],Entity_Type__c=definition[2],State__c='Succeeded',Started_At__c=cutoff.addMinutes(-2),Completed_At__c=cutoff,Source_Cutoff__c=cutoff,Processed_Count__c=processed,Success_Count__c=processed,Failure_Count__c=0,Inserted_Count__c=inserted,Updated_Count__c=processed-inserted,Deactivated_Count__c=0,Collision_Count__c=0,Completeness_Percent__c=100,Freshness_State__c='Fresh',Contract_Version__c='R360-MOCK-1.2',Commit_Mode__c='Atomic',Correlation_ID__c='R360-MOCK-1.2-'+definition[0],Detail__c='Deterministic sanitized source-contract fixture; no EXL production connector is active.'));index++;}if(!runs.isEmpty())insert runs;
    }

    private static void ensureRoleScopes(Date today){

public inherited sharing class Resource360SkillService {
    public static Resource360Service.ServiceResult submitClaim(Id resourceId,Id capabilityId,Integer requestedLevel,Decimal yearsExperience,String evidence,String idempotencyKey){
        Integer maximumLevel=Integer.valueOf(Resource360Policy.numberValue('Skill_Max_Level',4));Decimal maximumExperience=Resource360Policy.numberValue('Skill_Max_Experience_Years',50);if(requestedLevel==null||requestedLevel<1||requestedLevel>maximumLevel)fail('Requested proficiency must be between 1 and '+maximumLevel+'.');if(yearsExperience!=null&&(yearsExperience<0||yearsExperience>maximumExperience))fail('Years of experience must be between 0 and '+maximumExperience+'.');
        Resource360Security.requireResourceOwnership(resourceId,'Resource360_Review_Skills','You can submit only your own capability claim.');
        Capability__c capability=[SELECT Id,Active__c FROM Capability__c WHERE Id=:capabilityId WITH USER_MODE LIMIT 1];if(!capability.Active__c)fail('Only an active governed capability can be claimed.');
        String fingerprint=hash(String.join(new List<String>{String.valueOf(resourceId),String.valueOf(capabilityId),String.valueOf(requestedLevel),String.valueOf(yearsExperience),evidence},'|'));String correlation=correlationId();
        if(String.isNotBlank(idempotencyKey)){List<Skill_Claim__c> prior=[SELECT Id,Request_Fingerprint__c FROM Skill_Claim__c WHERE Idempotency_Key__c=:idempotencyKey WITH USER_MODE LIMIT 1];if(!prior.isEmpty()){if(prior[0].Request_Fingerprint__c!=fingerprint)fail('The idempotency key was already used with different skill evidence.');return result(true,'Existing capability claim returned.',prior[0].Id,correlation);}}
        if([SELECT COUNT() FROM Skill_Claim__c WHERE Resource__c=:resourceId AND Capability__c=:capabilityId AND State__c='Pending']>0)fail('A pending claim already exists for this capability.');
        Skill_Claim__c claim=new Skill_Claim__c(Resource__c=resourceId,Capability__c=capabilityId,Requested_Level__c=requestedLevel,Years_Experience__c=yearsExperience,Evidence__c=evidence,State__c='Pending',Submitted_At__c=System.now(),Idempotency_Key__c=String.isBlank(idempotencyKey)?correlation:idempotencyKey,Request_Fingerprint__c=fingerprint);claim=(Skill_Claim__c)Resource360Security.createable(new List<SObject>{claim})[0];insert claim;
        recordEvent(correlation,'SKILL_CLAIM_SUBMITTED',claim.Id,1,'PRACTITIONER_SUBMITTED','Capability claim submitted for manager review.',null,'Pending');notifyManager(correlation,resourceId,claim.Id);
        return result(true,'Capability claim submitted.',claim.Id,correlation);
    }

    public static Resource360Service.ServiceResult decideClaim(Id claimId,Boolean approve,Integer approvedLevel,String note){
        Resource360Security.requirePermission('Resource360_Review_Skills','Skill Reviewer permission is required to decide capability claims.');String correlation=correlationId();
        Skill_Claim__c claim=[SELECT Id,Resource__c,Resource__r.Salesforce_User__c,Resource__r.Manager__r.Salesforce_User__c,Resource__r.Org_Unit_ID__c,State__c,Requested_Level__c FROM Skill_Claim__c WHERE Id=:claimId WITH USER_MODE LIMIT 1 FOR UPDATE];
        if(claim.State__c!='Pending')fail('Only a pending skill claim can be decided.');if(claim.Resource__r.Salesforce_User__c==UserInfo.getUserId())fail('A practitioner cannot approve their own skill claim.');requireReviewerScope(claim.Resource__r.Manager__r.Salesforce_User__c,claim.Resource__r.Org_Unit_ID__c);
        Integer maximumLevel=Integer.valueOf(Resource360Policy.numberValue('Skill_Max_Level',4));if(approve&&(approvedLevel==null||approvedLevel<1||approvedLevel>maximumLevel))fail('Approved level must be between 1 and '+maximumLevel+'.');if(!approve&&String.isBlank(note))fail('A rejection note is required.');
        claim.State__c=approve?'Approved':'Rejected';claim.Approved_Level__c=approve?approvedLevel:null;claim.Reviewer__c=UserInfo.getUserId();claim.Decision_At__c=System.now();claim.Decision_Note__c=note;update claim;
        recordEvent(correlation,approve?'SKILL_CLAIM_APPROVED':'SKILL_CLAIM_REJECTED',claim.Id,1,approve?'MANAGER_APPROVED':'MANAGER_REJECTED',note,'Pending',claim.State__c);notifyResource(correlation,claim.Resource__c,approve?'Capability claim approved':'Capability claim rejected',approve?'Your capability claim was approved at level '+approvedLevel+'.':'Your capability claim was rejected: '+note,claim.Id);
        return result(true,approve?'Capability claim approved.':'Capability claim rejected.',claim.Id,correlation);
    }

    public static Resource360Service.ServiceResult addCredential(Id resourceId,String credentialId,String credentialName,String issuer,Date issueDate,Date expiryDate,String evidenceUrl){
        Resource360Security.requireResourceOwnership(resourceId,'Resource360_Manage_Credentials','You can add only your own credential evidence.');requireText(credentialId,'Credential ID is required.');requireText(credentialName,'Credential name is required.');requireText(issuer,'Credential issuer is required.');if(expiryDate!=null&&issueDate!=null&&expiryDate<issueDate)fail('Credential expiry cannot precede issue date.');
        String correlation=correlationId();List<Credential__c> prior=[SELECT Id FROM Credential__c WHERE Credential_ID__c=:credentialId WITH USER_MODE LIMIT 1];if(!prior.isEmpty())return result(true,'Existing credential returned.',prior[0].Id,correlation);
        Credential__c credential=new Credential__c(Resource__c=resourceId,Credential_ID__c=credentialId,Credential_Name__c=credentialName,Issuer__c=issuer,Issue_Date__c=issueDate,Expiry_Date__c=expiryDate,Evidence_URL__c=evidenceUrl,State__c='Unverified');credential=(Credential__c)Resource360Security.createable(new List<SObject>{credential})[0];insert credential;
        recordEvent(correlation,'CREDENTIAL_SUBMITTED',credential.Id,1,'EVIDENCE_ADDED','Credential evidence submitted for verification.',null,'Unverified');return result(true,'Credential submitted for verification.',credential.Id,correlation);
    }

    public static Resource360Service.ServiceResult verifyCredential(Id credentialId,String verificationState,String source,String note){
        Resource360Security.requirePermission('Resource360_Manage_Credentials','Credential Administrator permission is required.');Set<String>states=new Set<String>{'Verified','Revoked','Unknown'};if(!states.contains(verificationState))fail('Verification state must be Verified, Revoked or Unknown.');requireText(source,'Verification source is required.');if(verificationState!='Verified'&&String.isBlank(note))fail('A reason is required for revoked or unknown credentials.');
        String correlation=correlationId();Credential__c credential=[SELECT Id,Resource__c,State__c FROM Credential__c WHERE Id=:credentialId WITH USER_MODE LIMIT 1 FOR UPDATE];String prior=credential.State__c;credential.State__c=verificationState;credential.Verification_Source__c=source;credential.Verified_At__c=System.now();credential.Last_Checked_At__c=System.now();credential.Verification_Error__c=verificationState=='Unknown'?note:null;update credential;
        recordEvent(correlation,'CREDENTIAL_'+verificationState.toUpperCase(),credential.Id,1,'VERIFICATION_DECISION',note,prior,verificationState);notifyResource(correlation,credential.Resource__c,'Credential '+verificationState,verificationState=='Verified'?'Your credential was verified.':'Credential review result: '+note,credential.Id);
        return result(true,'Credential marked '+verificationState+'.',credential.Id,correlation);
    }

    private static void requireReviewerScope(Id managerUserId,String orgUnitId){if(Resource360Security.activeRoles().contains('Administrator'))return;if(managerUserId==UserInfo.getUserId())return;Date today=Date.today();Integer matches=[SELECT COUNT() FROM R360_Role_Scope__c WHERE User__c=:UserInfo.getUserId() AND Active__c=true AND Business_Role__c IN ('Reporting Manager','Capability Administrator') AND Valid_From__c<=:today AND (Valid_To__c=null OR Valid_To__c>=:today) AND (Org_Unit_ID__c=null OR Org_Unit_ID__c=:orgUnitId)];if(matches==0)fail('The claim is outside your manager or delegated capability-review scope.');}
    private static void notifyManager(String correlation,Id resourceId,Id claimId){Resource__c resource=[SELECT Manager__r.Salesforce_User__c FROM Resource__c WHERE Id=:resourceId WITH USER_MODE];if(resource.Manager__r.Salesforce_User__c!=null)Resource360EventService.enqueueNotification(correlation+'-manager',resource.Manager__r.Salesforce_User__c,'Capability review required','A practitioner capability claim is ready for review.','Normal','/lightning/r/Skill_Claim__c/'+claimId+'/view');}
    private static void notifyResource(String correlation,Id resourceId,String title,String message,Id recordId){Resource__c resource=[SELECT Salesforce_User__c FROM Resource__c WHERE Id=:resourceId WITH USER_MODE];if(resource.Salesforce_User__c!=null)Resource360EventService.enqueueNotification(correlation+'-resource',resource.Salesforce_User__c,title,message,'Normal','/lightning/r/'+String.valueOf(recordId.getSObjectType())+'/'+recordId+'/view');}
    private static void recordEvent(String correlation,String eventType,Id entityId,Decimal version,String reasonCode,String detail,String beforeState,String afterState){String entityType=eventType.startsWith('CREDENTIAL')?'Credential__c':'Skill_Claim__c';String role=Resource360Security.decisionRole(eventType.startsWith('CREDENTIAL')?'Resource360_Manage_Credentials':'Resource360_Review_Skills',eventType.startsWith('CREDENTIAL')?'Capability Administrator':'Reporting Manager');Resource360AuditService.record(correlation,role,eventType,entityType,entityId,version,reasonCode,detail,Resource360AuditService.state(beforeState,null),Resource360AuditService.state(afterState,detail));Resource360EventService.enqueue(correlation,eventType,entityType,entityId,version,new Map<String,Object>{'state'=>afterState});}
    private static String hash(String value){return EncodingUtil.convertToHex(Crypto.generateDigest('SHA-256',Blob.valueOf(value)));}private static Resource360Service.ServiceResult result(Boolean success,String message,Id recordId,String correlation){return new Resource360Service.ServiceResult(success,message,recordId,correlation);}private static String correlationId(){return EncodingUtil.convertToHex(Crypto.generateAesKey(128));}private static void requireText(String value,String message){if(String.isBlank(value))fail(message);}private static void fail(String message){throw new AuraHandledException(message);}
}

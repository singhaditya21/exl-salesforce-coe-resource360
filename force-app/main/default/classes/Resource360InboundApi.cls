            Resource360EventService.enqueue(correlation,'MASTER_DATA_INGESTED','R360_Integration_Run__c',run.Id,1,new Map<String,Object>{'sourceSystem'=>sourceSystem,'entityType'=>entityType,'state'=>run.State__c,'sourceCutoff'=>run.Source_Cutoff__c});

        String correlation=EncodingUtil.convertToHex(Crypto.generateAesKey(128));R360_Integration_Run__c run=new R360_Integration_Run__c(Run_ID__c=runId,Source_System__c=sourceSystem,Entity_Type__c=entityType,State__c='Running',Started_At__c=System.now(),Source_Cutoff__c=parseDateTime(envelope.get('sourceCutoff')),Correlation_ID__c=correlation);insert run;
        List<SObject> records=new List<SObject>();List<String> externalIds=new List<String>();List<Integer>acceptedRowNumbers=new List<Integer>();List<Map<String,Object>> acceptedPayloads=new List<Map<String,Object>>();List<R360_Integration_Error__c> errors=new List<R360_Integration_Error__c>();Schema.SObjectField externalField;

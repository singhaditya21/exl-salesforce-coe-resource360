        Map<String,Object> envelope=(Map<String,Object>)JSON.deserializeUntyped(RestContext.request.requestBody.toString());
        String runId=text(envelope,'runId',true);String sourceSystem=text(envelope,'sourceSystem',true);String entityType=text(envelope,'entityType',true);List<Object> sourceRecords=(List<Object>)envelope.get('records');if(sourceRecords==null)sourceRecords=new List<Object>();Integer maximumRows=Integer.valueOf(Resource360Policy.numberValue('Inbound_Max_Rows',200));if(sourceRecords.size()>maximumRows)throw new Resource360ApiException('A single ingestion request cannot exceed the configured '+maximumRows+' records.');

    @HttpGet
    global static ApiResponse health(){
        Resource360Security.requirePermission('Resource360_View_Operations','Resource 360 Operations access is required.');
        ApiResponse response=new ApiResponse();response.success=true;response.state='Ready';response.message='Resource360 master-data contract v1.1 is available. Credentials and endpoint activation remain environment-owned.';return response;
    }

    @HttpPost
    global static ApiResponse ingest(){

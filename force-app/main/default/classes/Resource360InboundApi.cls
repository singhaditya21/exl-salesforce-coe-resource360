    private static Map<String,Id> resourceIds(List<Object> records){Set<String> ids=new Set<String>();for(Object raw:records){Map<String,Object> item=(Map<String,Object>)raw;if(item.containsKey('employeeId'))ids.add(String.valueOf(item.get('employeeId')));}Map<String,Id> result=new Map<String,Id>();if(!ids.isEmpty())for(Resource__c record:[SELECT Id,Employee_ID__c FROM Resource__c WHERE Employee_ID__c IN:ids WITH USER_MODE])result.put(record.Employee_ID__c,record.Id);return result;}
    private static Map<String,Id> engagementIds(List<Object> records){Set<String> ids=new Set<String>();for(Object raw:records){Map<String,Object> item=(Map<String,Object>)raw;if(item.containsKey('engagementId'))ids.add(String.valueOf(item.get('engagementId')));}Map<String,Id> result=new Map<String,Id>();if(!ids.isEmpty())for(Engagement__c record:[SELECT Id,Engagement_ID__c FROM Engagement__c WHERE Engagement_ID__c IN:ids WITH USER_MODE])result.put(record.Engagement_ID__c,record.Id);return result;}
    private static R360_Integration_Error__c error(Id runId,String externalId,Integer rowNumber,String code,String message,Map<String,Object> payload){Integer retryMinutes=Integer.valueOf(Resource360Policy.numberValue('Integration_Error_Retry_Minutes',5));return new R360_Integration_Error__c(Integration_Run__c=runId,External_Record_ID__c=externalId,Row_Number__c=rowNumber,Error_Code__c=code,Error_Message__c=truncate(message,2000),Payload_Hash__c=EncodingUtil.convertToHex(Crypto.generateDigest('SHA-256',Blob.valueOf(JSON.serialize(payload)))),State__c='Retry Pending',Retry_Count__c=0,Next_Retry_At__c=System.now().addMinutes(retryMinutes));}
    private static String errorSummary(List<R360_Integration_Error__c> errors){List<String>parts=new List<String>();Integer count=Math.min(errors.size(),3);for(Integer index=0;index<count;index++)parts.add(errors[index].Error_Code__c+' - '+truncate(errors[index].Error_Message__c,350));return String.join(parts,' | ');}
    private static ApiResponse responseFor(R360_Integration_Run__c run,String runId,String message){ApiResponse response=new ApiResponse();response.success=run.State__c=='Succeeded';response.runId=runId;response.state=run.State__c;response.processed=Integer.valueOf(run.Processed_Count__c==null?0:run.Processed_Count__c);response.succeeded=Integer.valueOf(run.Success_Count__c==null?0:run.Success_Count__c);response.failed=Integer.valueOf(run.Failure_Count__c==null?0:run.Failure_Count__c);response.message=message;return response;}
    private static String text(Map<String,Object> source,String key,Boolean required){String value=source.get(key)==null?null:String.valueOf(source.get(key)).trim();if(required&&String.isBlank(value))throw new Resource360ApiException(key+' is required.');return value;}private static String defaultText(Map<String,Object>source,String key,String fallback){String value=text(source,key,false);return String.isBlank(value)?fallback:value;}private static Date parseDate(Object value){return value==null||String.isBlank(String.valueOf(value))?null:Date.valueOf(String.valueOf(value));}private static Date requiredDate(Object value,String key){Date result=parseDate(value);if(result==null)throw new Resource360ApiException(key+' is required.');return result;}private static DateTime parseDateTime(Object value){if(value==null||String.isBlank(String.valueOf(value)))return System.now();String raw=String.valueOf(value).replace('T',' ').replace('Z','');return DateTime.valueOfGmt(raw);}private static Decimal decimalValue(Object value,Decimal fallback){return value==null?fallback:Decimal.valueOf(String.valueOf(value));}private static Boolean booleanValue(Object value,Boolean fallback){return value==null?fallback:Boolean.valueOf(String.valueOf(value));}private static String truncate(String value,Integer length){return value!=null&&value.length()>length?value.substring(0,length):value;}

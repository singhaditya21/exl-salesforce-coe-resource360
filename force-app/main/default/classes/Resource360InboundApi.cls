                for(Integer index=0;index<results.size();index++){if(results[index].isSuccess())succeeded++;else errors.add(error(run.Id,externalIds[index],acceptedRowNumbers[index],'UPSERT_FAILED',results[index].getErrors()[0].getMessage(),acceptedPayloads[index]));}

    private class BuildResult{SObject record;String externalId;Schema.SObjectField externalField;BuildResult(SObject record,String externalId,Schema.SObjectField externalField){this.record=record;this.externalId=externalId;this.externalField=externalField;}}
    private static BuildResult build(String entityType,Map<String,Object> item,Map<String,Id> resourceIds,Map<String,Id> engagementIds){
        String normalized=entityType.toLowerCase();
        if(normalized=='employee'||normalized=='resource'){
            String employeeId=text(item,'employeeId',true);String entraId=text(item,'entraObjectId',false);List<Resource__c> existing=[SELECT Id,Entra_Object_ID__c FROM Resource__c WHERE Employee_ID__c=:employeeId WITH USER_MODE LIMIT 1];if(!existing.isEmpty()&&String.isNotBlank(existing[0].Entra_Object_ID__c)&&String.isNotBlank(entraId)&&existing[0].Entra_Object_ID__c!=entraId)throw new Resource360ApiException('Identity collision: Employee ID is already bound to a different Entra object.');
            Resource__c record=new Resource__c(Employee_ID__c=employeeId,Preferred_Name__c=text(item,'preferredName',true),Work_Email__c=text(item,'workEmail',false),Status__c=defaultText(item,'status','Active'),Employment_Start__c=requiredDate(item.get('employmentStart'),'employmentStart'),Employment_End__c=parseDate(item.get('employmentEnd')),Grade__c=text(item,'grade',false),Tower__c=text(item,'tower',true),Primary_Role__c=text(item,'primaryRole',false),Location__c=text(item,'location',false),Time_Zone__c=defaultText(item,'timeZone','Asia/Kolkata'),Org_Unit_ID__c=text(item,'orgUnitId',false),Entra_Object_ID__c=entraId,Daily_Capacity_Hours__c=decimalValue(item.get('dailyCapacityHours'),Resource360Policy.numberValue('Default_Daily_Capacity',8)),Available_Percent__c=decimalValue(item.get('availablePercent'),0),Source_Last_Sync__c=System.now());return new BuildResult(record,employeeId,Resource__c.Employee_ID__c);
        }

        }
        if(normalized=='credential'){
            String id=text(item,'credentialId',true);String employeeId=text(item,'employeeId',true);if(!resourceIds.containsKey(employeeId))throw new Resource360ApiException('Credential employee ID does not resolve to a Resource 360 resource.');Credential__c record=new Credential__c(Credential_ID__c=id,Resource__c=resourceIds.get(employeeId),Credential_Name__c=text(item,'name',true),Issuer__c=defaultText(item,'issuer','Salesforce'),State__c=defaultText(item,'state','Unknown'),Issue_Date__c=parseDate(item.get('issueDate')),Expiry_Date__c=parseDate(item.get('expiryDate')),Maintenance_Date__c=parseDate(item.get('maintenanceDate')),Verification_Source__c=text(item,'verificationSource',false),Verified_At__c=parseDateTime(item.get('verifiedAt')),Last_Checked_At__c=System.now());return new BuildResult(record,id,Credential__c.Credential_ID__c);
        }
        if(normalized=='learningachievement'){
            String id=text(item,'achievementId',true);String employeeId=text(item,'employeeId',true);if(!resourceIds.containsKey(employeeId))throw new Resource360ApiException('Learning employee ID does not resolve to a Resource 360 resource.');R360_Learning_Achievement__c record=new R360_Learning_Achievement__c(Achievement_ID__c=id,Resource__c=resourceIds.get(employeeId),Course_Name__c=text(item,'courseName',true),Provider__c=text(item,'provider',true),Completed_On__c=parseDate(item.get('completedOn')),State__c=defaultText(item,'state','Completed'),Source_Last_Sync__c=System.now());return new BuildResult(record,id,R360_Learning_Achievement__c.Achievement_ID__c);
        }
        if(normalized=='commercialreference'){
            String id=text(item,'externalId',true);String engagementId=text(item,'engagementId',true);if(!engagementIds.containsKey(engagementId))throw new Resource360ApiException('Commercial engagement ID does not resolve.');Commercial_Reference__c record=new Commercial_Reference__c(External_ID__c=id,Engagement__c=engagementIds.get(engagementId),Reference_Type__c=defaultText(item,'referenceType','SOW'),Value__c=decimalValue(item.get('value'),null),Valid_From__c=parseDate(item.get('validFrom')),Valid_To__c=parseDate(item.get('validTo')),Status__c=defaultText(item,'status','Active'),Signature__c=text(item,'signature',true),Source_Last_Sync__c=System.now());return new BuildResult(record,id,Commercial_Reference__c.External_ID__c);
        }
        if(normalized=='orgunit'){
            String id=text(item,'orgUnitId',true);R360_Org_Unit__c record=new R360_Org_Unit__c(Org_Unit_ID__c=id,Name=text(item,'name',true),Unit_Type__c=text(item,'unitType',true),Effective_From__c=parseDate(item.get('effectiveFrom')),Effective_To__c=parseDate(item.get('effectiveTo')),Current__c=booleanValue(item.get('current'),true));return new BuildResult(record,id,R360_Org_Unit__c.Org_Unit_ID__c);

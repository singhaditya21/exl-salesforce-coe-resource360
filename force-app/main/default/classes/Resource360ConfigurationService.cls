    @AuraEnabled(cacheable=true)
    public static List<ConfigurationItem> catalog(){
        requireView();List<ConfigurationItem> result=new List<ConfigurationItem>();
        for(R360_Policy__mdt policy:R360_Policy__mdt.getAll().values()){ConfigurationItem item=new ConfigurationItem();item.source='Deployed Default';item.domain=policy.DeveloperName.startsWith('Escalation_')?'Escalation':'Policy';item.key=item.domain.toUpperCase()+'.'+policy.DeveloperName;item.code=policy.DeveloperName;item.label=policy.MasterLabel;item.valueType=policy.Numeric_Value__c!=null?'Number':policy.DeveloperName.startsWith('Escalation_')?'JSON':String.isNotBlank(policy.Text_Value__c)?'Text':'Boolean';item.value=policy.Numeric_Value__c!=null?String.valueOf(policy.Numeric_Value__c):String.isNotBlank(policy.Text_Value__c)?policy.Text_Value__c:String.valueOf(policy.Boolean_Value__c);item.state=policy.Active__c?'Active':'Retired';item.version=1;item.current=true;item.effectiveFrom=policy.Effective_From__c;item.effectiveTo=policy.Effective_To__c;item.impact=impactFor(item.domain,item.code);item.validation='Deployable safe default';result.add(item);}
        for(R360_Delivery_Role__mdt role:R360_Delivery_Role__mdt.getAll().values()){ConfigurationItem item=new ConfigurationItem();item.source='Deployed Default';item.domain='Delivery Role';item.key='DELIVERY_ROLE.'+role.Role_Code__c;item.code=role.Role_Code__c;item.label=role.MasterLabel;item.valueType='Boolean';item.value=String.valueOf(role.Active__c);item.state=role.Active__c?'Active':'Retired';item.version=1;item.current=true;item.effectiveFrom=role.Effective_From__c;item.effectiveTo=role.Effective_To__c;item.impact='Staffing, WBS, talent search and practitioner profiles · tower '+role.Tower__c;item.validation='Deployable safe default';result.add(item);}
        for(R360_Classification__mdt classification:R360_Classification__mdt.getAll().values()){ConfigurationItem item=new ConfigurationItem();item.source='Deployed Default';item.domain='Classification';item.key='CLASSIFICATION.'+classification.Classification_Value__c;item.code=classification.Classification_Value__c;item.label=classification.MasterLabel;item.valueType='Boolean';item.value=String.valueOf(classification.Active__c);item.state=classification.Active__c?'Active':'Retired';item.version=1;item.current=true;item.effectiveFrom=classification.Effective_From__c;item.effectiveTo=classification.Effective_To__c;item.impact='Staffing, billability snapshots, SOW/control gates and analytics';item.validation='Deployable safe default';result.add(item);}
        for(R360_Configuration__c record:configurationRecords()){result.add(toItem(record));}
        return result;
    }

    @AuraEnabled(cacheable=true)
    public static String publicSnapshot(){
        Map<String,Object> result=new Map<String,Object>();result.put('policyVersion',Resource360Policy.textValue('Policy_Version','R360-POLICY-2.0'));result.put('effortModes',lookupValues('Planning_Effort_Modes',new List<String>{'Daily Hours','Allocation Percent','Total Hours'}));result.put('budgetPhases',lookupValues('Budget_Phases',new List<String>{'Discover','Design','Build','Test','Deploy','Deliver'}));result.put('workUnits',lookupValues('Budget_Work_Units',new List<String>{'Architecture','Delivery','Data Cloud Foundation','Integration','Quality Assurance','Release'}));result.put('locations',lookupValues('Delivery_Locations',new List<String>{'India','Bengaluru','Pune','Hyderabad','Noida','Gurugram','Onsite'}));result.put('talentDefaultResults',Resource360Policy.numberValue('Talent_Default_Results',50));result.put('talentMaxResults',Resource360Policy.numberValue('Talent_Max_Results',100));result.put('timesheetSubmissionBusinessDays',Resource360Policy.numberValue('Timesheet_Submission_Business_Days',2));result.put('timesheetSubmissionHour',Resource360Policy.numberValue('Timesheet_Submission_Hour',18));result.put('bulkMaxRows',Resource360Policy.numberValue('Bulk_Max_Rows',200));result.put('operationsScheduleCron',Resource360Policy.textValue('Operations_Schedule_Cron','0 0 * * * ?'));result.put('freshnessThresholds',Resource360FreshnessService.configuredThresholds());result.put('kpiTargets',new Map<String,Object>{'billed'=>Resource360Policy.numberValue('KPI_Billed_Target_Percent',75),'warMax'=>Resource360Policy.numberValue('KPI_WAR_Max_Percent',10),'ifbMax'=>Resource360Policy.numberValue('KPI_IFB_Max_Percent',2)});return JSON.serialize(result);

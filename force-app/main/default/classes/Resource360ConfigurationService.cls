    @AuraEnabled(cacheable=true)
    public static ConfigurationPreview preview(String domain,String code,String displayLabel,String valueType,Decimal numericValue,String textValue,Boolean booleanValue,String attributesJson,String unit,Date effectiveFrom,Date effectiveTo,String reason){
        requireManage();R360_Configuration__c candidate=build(null,domain,code,displayLabel,valueType,numericValue,textValue,booleanValue,attributesJson,unit,effectiveFrom,effectiveTo,reason);return previewRecord(candidate);
    }

    @AuraEnabled
    public static Resource360Service.ServiceResult saveDraft(Id settingId,String domain,String code,String displayLabel,String valueType,Decimal numericValue,String textValue,Boolean booleanValue,String attributesJson,String unit,Date effectiveFrom,Date effectiveTo,String reason){
        requireManage();R360_Configuration__c candidate=build(settingId,domain,code,displayLabel,valueType,numericValue,textValue,booleanValue,attributesJson,unit,effectiveFrom,effectiveTo,reason);ConfigurationPreview checked=previewRecord(candidate);if(!checked.valid)fail(String.join(checked.errors,' '));String correlation=correlationId();Map<String,Object>beforeState=null;
        if(settingId==null){AggregateResult aggregate=[SELECT MAX(Version__c) maximum FROM R360_Configuration__c WHERE Configuration_Key__c=:candidate.Configuration_Key__c];Decimal maximum=(Decimal)aggregate.get('maximum');candidate.Version__c=maximum==null?1:maximum+1;candidate.Version_Key__c=candidate.Configuration_Key__c+'-V'+String.valueOf(candidate.Version__c);candidate.State__c='Draft';candidate.Current__c=false;candidate.Validation_Summary__c=checked.validation;insert candidate;}else{R360_Configuration__c existing=recordForUpdate(settingId);if(!new Set<String>{'Draft','Rejected'}.contains(existing.State__c))fail('Only a draft or rejected configuration can be edited.');beforeState=state(existing);candidate.Id=existing.Id;candidate.Version__c=existing.Version__c;candidate.Version_Key__c=existing.Version_Key__c;candidate.State__c='Draft';candidate.Current__c=false;candidate.Validation_Summary__c=checked.validation;candidate.Submitted_By__c=null;candidate.Submitted_At__c=null;candidate.Approved_By__c=null;candidate.Approved_At__c=null;update candidate;}
        Resource360AuditService.record(correlation,'Operations','CONFIG_DRAFT_SAVED','R360_Configuration__c',candidate.Id,candidate.Version__c,'VALIDATED_DRAFT',candidate.Configuration_Key__c+' draft saved after configuration preview.',beforeState,state(candidate));return result(true,'Configuration draft saved and validated.',candidate.Id,correlation);
    }

    @AuraEnabled
    public static Resource360Service.ServiceResult submit(Id settingId){requireManage();R360_Configuration__c record=recordForUpdate(settingId);if(!new Set<String>{'Draft','Rejected'}.contains(record.State__c))fail('Only a draft or rejected configuration can be submitted.');ConfigurationPreview checked=previewRecord(record);if(!checked.valid)fail(String.join(checked.errors,' '));Map<String,Object>beforeState=state(record);record.State__c='Pending Approval';record.Submitted_By__c=UserInfo.getUserId();record.Submitted_At__c=System.now();record.Validation_Summary__c=checked.validation;update record;String correlation=correlationId();Resource360AuditService.record(correlation,'Operations','CONFIG_SUBMITTED','R360_Configuration__c',record.Id,record.Version__c,'APPROVAL_REQUIRED',record.Configuration_Key__c+' submitted for controlled activation.',beforeState,state(record));return result(true,'Configuration submitted for approval.',record.Id,correlation);}

    @AuraEnabled
    public static Resource360Service.ServiceResult decide(Id settingId,Boolean approve,String note){requireApprove();if(!approve&&String.isBlank(note))fail('A rejection reason is required.');R360_Configuration__c record=recordForUpdate(settingId);if(record.State__c!='Pending Approval')fail('Only a pending configuration can be decided.');if(record.Submitted_By__c==UserInfo.getUserId())fail('The configuration submitter cannot approve or reject the same version.');ConfigurationPreview checked=previewRecord(record);if(approve&&!checked.valid)fail(String.join(checked.errors,' '));Map<String,Object>beforeState=state(record);String correlation=correlationId();if(approve)activate(record,note);else{record.State__c='Rejected';record.Current__c=false;record.Approved_By__c=UserInfo.getUserId();record.Approved_At__c=System.now();record.Change_Reason__c=String.isBlank(record.Change_Reason__c)?note:record.Change_Reason__c+' · Decision: '+note;update record;}clearCache();Resource360AuditService.record(correlation,'Configuration Approver',approve?'CONFIG_ACTIVATED':'CONFIG_REJECTED','R360_Configuration__c',record.Id,record.Version__c,approve?'EFFECTIVE_VERSION':'CONTROL_REJECTED',(approve?'Activated ':'Rejected ')+record.Configuration_Key__c+'. '+String.valueOf(note),beforeState,state(record));return result(true,approve?'Configuration version activated.':'Configuration rejected.',record.Id,correlation);}

    @AuraEnabled
    public static Resource360Service.ServiceResult rollback(Id priorSettingId,String reason){requireApprove();if(String.isBlank(reason))fail('A rollback reason is required.');R360_Configuration__c prior=[SELECT Configuration_Key__c,Domain__c,Code__c,Display_Label__c,Value_Type__c,Numeric_Value__c,Text_Value__c,Boolean_Value__c,Attributes_JSON__c,Unit__c FROM R360_Configuration__c WHERE Id=:priorSettingId LIMIT 1];R360_Configuration__c copy=build(null,prior.Domain__c,prior.Code__c,prior.Display_Label__c,prior.Value_Type__c,prior.Numeric_Value__c,prior.Text_Value__c,prior.Boolean_Value__c,prior.Attributes_JSON__c,prior.Unit__c,Resource360Policy.effectiveDate(),null,'Rollback: '+reason);AggregateResult aggregate=[SELECT MAX(Version__c) maximum FROM R360_Configuration__c WHERE Configuration_Key__c=:copy.Configuration_Key__c];Decimal maximum=(Decimal)aggregate.get('maximum');copy.Version__c=maximum==null?1:maximum+1;copy.Version_Key__c=copy.Configuration_Key__c+'-V'+String.valueOf(copy.Version__c);copy.State__c='Draft';copy.Current__c=false;copy.Validation_Summary__c=previewRecord(copy).validation;insert copy;copy.State__c='Pending Approval';copy.Submitted_By__c=UserInfo.getUserId();copy.Submitted_At__c=System.now();update copy;activate(copy,reason);clearCache();String correlation=correlationId();Resource360AuditService.record(correlation,'Configuration Approver','CONFIG_ROLLED_BACK','R360_Configuration__c',copy.Id,copy.Version__c,'PRIOR_VALUE_RESTORED',copy.Configuration_Key__c+' restored from configuration '+priorSettingId+'.',null,state(copy));return result(true,'Prior value restored as a new active version.',copy.Id,correlation);}

    @AuraEnabled
    public static Resource360Service.ServiceResult rescheduleOperations(){requireApprove();String cron=Resource360Policy.textValue('Operations_Schedule_Cron','0 0 * * * ?');String jobName='Resource360 Operational Controls';try{for(CronTrigger existing:[SELECT Id FROM CronTrigger WHERE CronJobDetail.Name=:jobName])System.abortJob(existing.Id);String jobId=System.schedule(jobName,cron,new Resource360OperationsScheduler());String correlation=correlationId();Resource360AuditService.record(correlation,'Configuration Approver','OPERATIONS_SCHEDULE_APPLIED','CronTrigger',Id.valueOf(jobId),1,'CONFIGURED_CRON','Applied governed operations schedule '+cron+'.',null,new Map<String,Object>{'cron'=>cron,'jobId'=>jobId});return result(true,'Operational controls rescheduled using '+cron+'.',Id.valueOf(jobId),correlation);}catch(Exception failure){fail('The configured cron expression could not be scheduled: '+failure.getMessage());}return null;}

    public static List<R360_Configuration__c> activeDomain(String domain){if(!activeDomainCache.containsKey(domain)){Date today=Resource360Policy.effectiveDate();activeDomainCache.put(domain,[SELECT Id,Configuration_Key__c,Domain__c,Code__c,Display_Label__c,Value_Type__c,Numeric_Value__c,Text_Value__c,Boolean_Value__c,Attributes_JSON__c,Unit__c,State__c,Version__c,Current__c,Effective_From__c,Effective_To__c FROM R360_Configuration__c WHERE Domain__c=:domain AND State__c='Active' AND Effective_From__c<=:today AND (Effective_To__c=null OR Effective_To__c>=:today) ORDER BY Version__c DESC]);}return activeDomainCache.get(domain);}

    @TestVisible public static void clearCache(){activeDomainCache.clear();Resource360Policy.clearCache();}

    public static List<String> lookupValues(String listKey,List<String> fallback){List<String>values=new List<String>();values.addAll(Resource360Policy.listValue(listKey,fallback));Set<String>seenCodes=new Set<String>();for(R360_Configuration__c record:activeDomain('General LOV')){Map<String,Object>attrs=attributes(record.Attributes_JSON__c);if(String.valueOf(attrs.get('listKey'))!=listKey||seenCodes.contains(record.Code__c))continue;seenCodes.add(record.Code__c);String label=record.Display_Label__c;if(record.Boolean_Value__c==true&&!values.contains(label))values.add(label);if(record.Boolean_Value__c!=true){removeValue(values,label);removeValue(values,record.Code__c);}}return values;}

    public static List<String> validateRecord(R360_Configuration__c record){List<String>errors=new List<String>();if(!DOMAINS.contains(record.Domain__c))errors.add('Select a supported configuration domain.');if(String.isBlank(record.Code__c))errors.add('A stable configuration code is required.');if(!VALUE_TYPES.contains(record.Value_Type__c))errors.add('Select Number, Text, Boolean or JSON.');if(record.Effective_From__c==null)errors.add('Effective From is required.');if(record.Effective_To__c!=null&&record.Effective_To__c<record.Effective_From__c)errors.add('Effective To cannot precede Effective From.');if(String.isBlank(record.Change_Reason__c))errors.add('A change reason is required.');if(record.Value_Type__c=='Number'&&record.Numeric_Value__c==null)errors.add('Numeric Value is required for a Number setting.');if(record.Value_Type__c=='Text'&&String.isBlank(record.Text_Value__c))errors.add('Text Value is required for a Text setting.');if(record.Value_Type__c=='JSON'){if(String.isBlank(record.Attributes_JSON__c))errors.add('Attributes JSON is required for a JSON setting.');else try{JSON.deserializeUntyped(record.Attributes_JSON__c);}catch(Exception failure){errors.add('Attributes JSON is invalid: '+failure.getMessage());}}if(String.isNotBlank(record.Attributes_JSON__c)&&record.Value_Type__c!='JSON')try{JSON.deserializeUntyped(record.Attributes_JSON__c);}catch(Exception failure){errors.add('Attributes JSON is invalid: '+failure.getMessage());}if(record.Code__c!=null&&record.Code__c.startsWith('Escalation_')&&String.isNotBlank(record.Attributes_JSON__c))errors.addAll(validateEscalationTiers(record.Attributes_JSON__c));if(new Set<String>{'Delivery Role','Classification','General LOV'}.contains(record.Domain__c)){if(record.Value_Type__c!='Boolean')errors.add(record.Domain__c+' configuration must use Boolean to enable or disable the value.');if(String.isBlank(record.Display_Label__c))errors.add('A display label is required for governed values.');}if(record.Domain__c=='Delivery Role'&&record.Boolean_Value__c==true){Map<String,Object>attributes=attributes(record.Attributes_JSON__c);if(String.isBlank((String)attributes.get('tower')))errors.add('Enabled delivery roles require a tower attribute.');}if(record.Domain__c=='Classification'&&record.Boolean_Value__c==true){Map<String,Object>attributes=attributes(record.Attributes_JSON__c);for(String key:new List<String>{'billable','requiresControl','requiresSow'})if(!attributes.containsKey(key))errors.add('Enabled classifications require '+key+' in Attributes JSON.');}if(record.Domain__c=='General LOV'){Map<String,Object>lovAttributes=attributes(record.Attributes_JSON__c);if(!lovAttributes.containsKey('listKey')||String.isBlank((String)lovAttributes.get('listKey')))errors.add('General LOV values require a listKey in Attributes JSON.');}String content=(String.valueOf(record.Configuration_Key__c)+' '+String.valueOf(record.Text_Value__c)+' '+String.valueOf(record.Attributes_JSON__c)).toLowerCase();for(String forbidden:new List<String>{'client_secret','refresh_token','private key','sfdxauthurl','bearer '})if(content.contains(forbidden))errors.add('Secrets and authentication material are prohibited in Resource360 configuration.');if(record.Value_Type__c=='Number'&&NUMERIC_BOUNDS.containsKey(record.Code__c)){List<Decimal>bounds=NUMERIC_BOUNDS.get(record.Code__c);if(record.Numeric_Value__c<bounds[0]||record.Numeric_Value__c>bounds[1])errors.add(record.Code__c+' must be between '+bounds[0]+' and '+bounds[1]+'.');}Set<String>runtimeDomains=new Set<String>{'Policy','Approval','Escalation','Notification','Integration','KPI'};if(runtimeDomains.contains(record.Domain__c)&&knownPolicy(record.Code__c)){List<R360_Configuration__c>duplicates=[SELECT Id FROM R360_Configuration__c WHERE Code__c=:record.Code__c AND State__c='Active' AND Configuration_Key__c!=:record.Configuration_Key__c LIMIT 1];if(!duplicates.isEmpty())errors.add('This runtime policy code is already active in another domain; retire it before moving domains.');}return errors;}

    private static ConfigurationPreview previewRecord(R360_Configuration__c record){ConfigurationPreview result=new ConfigurationPreview();result.key=record.Configuration_Key__c;result.errors=validateRecord(record);result.warnings=new List<String>();result.valid=result.errors.isEmpty();result.normalizedValue=valueOf(record);result.impact=impactFor(record.Domain__c,record.Code__c);if(new Set<String>{'Policy','Approval','Escalation','Notification','Integration','KPI'}.contains(record.Domain__c)&&!knownPolicy(record.Code__c))result.warnings.add('No consuming service is registered for this policy key; the version will be governed but inert until a service adopts it.');List<R360_Configuration__c>active=[SELECT Id,Value_Type__c,Numeric_Value__c,Text_Value__c,Boolean_Value__c,Attributes_JSON__c,Effective_From__c,Effective_To__c FROM R360_Configuration__c WHERE Configuration_Key__c=:record.Configuration_Key__c AND State__c='Active' ORDER BY Version__c DESC LIMIT 1];result.currentValue=active.isEmpty()?'Deployed default':valueOf(active[0]);if(record.Code__c.startsWith('Talent_Weight_')){Decimal total=record.Numeric_Value__c;for(String key:new List<String>{'Talent_Weight_Capability','Talent_Weight_Project','Talent_Weight_Industry','Talent_Weight_Credential','Talent_Weight_Experience','Talent_Weight_Availability'})if(key!=record.Code__c)total+=Resource360Policy.numberValue(key,defaultWeight(key));if(total<=0)result.errors.add('At least one talent scoring weight must be greater than zero.');else if(total!=100)result.warnings.add('The six active weights total '+total+' and will be proportionally normalized to 100 at runtime.');}if(record.Code__c=='Budget_HOD_Margin'&&record.Numeric_Value__c>Resource360Policy.numberValue('Budget_Auto_Approve_Margin',30))result.errors.add('HOD margin cannot exceed the auto-approval margin.');if(record.Code__c=='Budget_Executive_Margin'&&record.Numeric_Value__c>Resource360Policy.numberValue('Budget_HOD_Margin',25))result.errors.add('Executive margin cannot exceed the HOD margin.');if(record.Code__c=='People_Freshness_Warn_Hours'&&record.Numeric_Value__c>=Resource360Policy.numberValue('People_Freshness_Block_Hours',24))result.errors.add('People warning threshold must be below the blocking threshold.');if(record.Code__c=='People_Freshness_Block_Hours'&&record.Numeric_Value__c<=Resource360Policy.numberValue('People_Freshness_Warn_Hours',8))result.errors.add('People blocking threshold must be above the warning threshold.');if(record.Code__c=='Learning_Freshness_Warn_Hours'&&record.Numeric_Value__c>=Resource360Policy.numberValue('Learning_Freshness_Disable_Hours',168))result.errors.add('Learning warning threshold must be below the disable threshold.');if(record.Code__c=='Learning_Freshness_Disable_Hours'&&record.Numeric_Value__c<=Resource360Policy.numberValue('Learning_Freshness_Warn_Hours',48))result.errors.add('Learning disable threshold must be above the warning threshold.');result.valid=result.errors.isEmpty();result.validation=result.valid?'Validated; '+result.impact+(result.warnings.isEmpty()?'.':' · '+String.join(result.warnings,' ')):String.join(result.errors,' ');return result;}

    private static void activate(R360_Configuration__c record,String note){List<R360_Configuration__c>existing=[SELECT Id,State__c,Current__c,Effective_From__c,Effective_To__c FROM R360_Configuration__c WHERE Configuration_Key__c=:record.Configuration_Key__c AND State__c='Active' AND Id!=:record.Id FOR UPDATE];Date start=record.Effective_From__c;for(R360_Configuration__c prior:existing){prior.Current__c=false;Boolean overlaps=(prior.Effective_To__c==null||prior.Effective_To__c>=start);if(overlaps&&prior.Effective_From__c<start){prior.Effective_To__c=start.addDays(-1);if(prior.Effective_To__c<Resource360Policy.effectiveDate())prior.State__c='Retired';}else if(overlaps)prior.State__c='Retired';}if(!existing.isEmpty())update existing;record.State__c='Active';record.Current__c=true;record.Approved_By__c=UserInfo.getUserId();record.Approved_At__c=System.now();if(String.isNotBlank(note))record.Change_Reason__c=record.Change_Reason__c+' · Decision: '+note;update record;}
    private static R360_Configuration__c build(Id settingId,String domain,String code,String displayLabel,String valueType,Decimal numericValue,String textValue,Boolean booleanValue,String attributesJson,String unit,Date effectiveFrom,Date effectiveTo,String reason){String safeDomain=String.isBlank(domain)?'':domain.trim();String safeCode=String.isBlank(code)?'':code.trim();R360_Configuration__c result=new R360_Configuration__c(Id=settingId,Domain__c=safeDomain,Code__c=safeCode,Display_Label__c=String.isBlank(displayLabel)?safeCode:displayLabel.trim(),Value_Type__c=valueType,Numeric_Value__c=numericValue,Text_Value__c=textValue,Boolean_Value__c=booleanValue==true,Attributes_JSON__c=attributesJson,Unit__c=unit,Effective_From__c=effectiveFrom,Effective_To__c=effectiveTo,Change_Reason__c=reason);result.Configuration_Key__c=safeDomain.toUpperCase().replace(' ','_')+'.'+safeCode;return result;}
    private static List<R360_Configuration__c>configurationRecords(){return [SELECT Id,Configuration_Key__c,Domain__c,Code__c,Display_Label__c,Value_Type__c,Numeric_Value__c,Text_Value__c,Boolean_Value__c,Attributes_JSON__c,Unit__c,State__c,Version__c,Current__c,Effective_From__c,Effective_To__c,Validation_Summary__c FROM R360_Configuration__c ORDER BY Configuration_Key__c,Version__c DESC LIMIT 500];}
    private static R360_Configuration__c recordForUpdate(Id id){return [SELECT Id,Configuration_Key__c,Version_Key__c,Domain__c,Code__c,Display_Label__c,Value_Type__c,Numeric_Value__c,Text_Value__c,Boolean_Value__c,Attributes_JSON__c,Unit__c,State__c,Version__c,Current__c,Effective_From__c,Effective_To__c,Change_Reason__c,Validation_Summary__c,Submitted_By__c,Submitted_At__c,Approved_By__c,Approved_At__c FROM R360_Configuration__c WHERE Id=:id LIMIT 1 FOR UPDATE];}
    private static ConfigurationItem toItem(R360_Configuration__c record){ConfigurationItem item=new ConfigurationItem();item.id=record.Id;item.source='Runtime Override';item.domain=record.Domain__c;item.key=record.Configuration_Key__c;item.code=record.Code__c;item.label=record.Display_Label__c;item.valueType=record.Value_Type__c;item.value=valueOf(record);item.unit=record.Unit__c;item.state=record.State__c;item.version=record.Version__c;item.current=record.Current__c;item.effectiveFrom=record.Effective_From__c;item.effectiveTo=record.Effective_To__c;item.impact=impactFor(record.Domain__c,record.Code__c);item.validation=record.Validation_Summary__c;return item;}
    private static String valueOf(R360_Configuration__c record){if(record.Value_Type__c=='Number')return String.valueOf(record.Numeric_Value__c);if(record.Value_Type__c=='Boolean')return String.valueOf(record.Boolean_Value__c);if(record.Value_Type__c=='JSON')return record.Attributes_JSON__c;return record.Text_Value__c;}
    private static Map<String,Object>state(R360_Configuration__c record){return new Map<String,Object>{'key'=>record.Configuration_Key__c,'version'=>record.Version__c,'state'=>record.State__c,'value'=>valueOf(record),'effectiveFrom'=>record.Effective_From__c,'effectiveTo'=>record.Effective_To__c};}
    private static String impactFor(String domain,String code){if(domain=='Delivery Role')return 'Staffing, WBS, talent search and practitioner profiles';if(domain=='Classification')return 'Staffing controls, billability snapshots and Command Center';if(domain=='General LOV')return 'Lightning forms and bulk validation';if(domain=='Integration')return 'Inbound contracts, schedules and operations';if(domain=='Notification'||domain=='Escalation')return 'Operational alerts, owners and SLA evidence';if(domain=='KPI')return 'Command Center targets and status';if(code.contains('_Freshness_'))return 'Source-health display and fail-closed staffing, budget or learning controls';if(code.startsWith('Budget_'))return 'Budget validation and approval routing';if(code.startsWith('Talent_')||code.startsWith('Skill_'))return 'Skills, candidate eligibility and explainable ranking';if(code.startsWith('Timesheet_'))return 'Timesheet deadlines, decisions and corrections';if(code.startsWith('Outbox_'))return 'Durable event retry and dead-letter controls';if(code.startsWith('Staffing_')||code.startsWith('Planning_')||code.startsWith('Capacity_'))return 'Staffing SLA and allocation planning';return 'Resource360 governed runtime policy';}
    private static Boolean knownPolicy(String code){return NUMERIC_BOUNDS.containsKey(code)||code.startsWith('Escalation_')||new Set<String>{'Policy_Version','Planning_Effort_Modes','Budget_Phases','Budget_Work_Units','Delivery_Locations','Operations_Schedule_Cron','Outbox_Retry_Minutes','Budget_Portfolio_Approver_Role','Budget_HOD_Approver_Role','Budget_Executive_Approver_Role','Timesheet_Correction_Dual_Control','Time_Correction_First_Approver_Role','Time_Correction_Second_Approver_Role','Notification_Channels'}.contains(code);}
    private static Decimal defaultWeight(String code){return new Map<String,Decimal>{'Talent_Weight_Capability'=>35,'Talent_Weight_Project'=>20,'Talent_Weight_Industry'=>15,'Talent_Weight_Credential'=>10,'Talent_Weight_Experience'=>10,'Talent_Weight_Availability'=>10}.get(code);}
    private static Map<String,Object>attributes(String value){if(String.isBlank(value))return new Map<String,Object>();try{return (Map<String,Object>)JSON.deserializeUntyped(value);}catch(Exception failure){return new Map<String,Object>();}}
    private static List<String>validateEscalationTiers(String value){List<String>errors=new List<String>();try{List<Object>tiers=(List<Object>)JSON.deserializeUntyped(value);if(tiers.isEmpty())errors.add('Escalation policy requires at least one tier.');Decimal prior=0;Set<String>severities=new Set<String>{'Normal','High','Critical'};for(Object raw:tiers){Map<String,Object>tier=(Map<String,Object>)raw;Decimal days=tier.get('days')==null?null:Decimal.valueOf(String.valueOf(tier.get('days')));String role=(String)tier.get('role');String severity=(String)tier.get('severity');if(days==null||days<=prior)errors.add('Escalation tier days must be positive and strictly increasing.');if(String.isBlank(role))errors.add('Every escalation tier requires a business role.');if(!severities.contains(severity))errors.add('Escalation severity must be Normal, High or Critical.');if(days!=null)prior=days;}}catch(Exception failure){errors.add('Escalation policy must be a JSON array of {days, role, severity} tiers.');}return errors;}
    private static void removeValue(List<String>values,String target){for(Integer index=values.size()-1;index>=0;index--)if(values[index]==target)values.remove(index);}
    private static void requireView(){if(Resource360Security.hasPermission('Resource360_Manage_Configuration')||Resource360Security.hasPermission('Resource360_Approve_Configuration')||Resource360Security.hasPermission('Resource360_View_Audit'))return;fail('Configuration view permission is required.');}
    private static void requireManage(){Resource360Security.requirePermission('Resource360_Manage_Configuration','Configuration management permission is required.');}
    private static void requireApprove(){Resource360Security.requirePermission('Resource360_Approve_Configuration','Configuration approval permission is required.');}
    private static Resource360Service.ServiceResult result(Boolean success,String message,Id recordId,String correlation){return new Resource360Service.ServiceResult(success,message,recordId,correlation);}private static String correlationId(){return EncodingUtil.convertToHex(Crypto.generateAesKey(128));}private static void fail(String message){throw new AuraHandledException(message);}

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Credential_Date_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Issue_Date__c)), NOT(ISBLANK(Expiry_Date__c)), Expiry_Date__c &lt; Issue_Date__c)</errorConditionFormula>
    <errorMessage>Credential expiry cannot precede the issue date.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Line_Values</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Planned_Hours__c &lt; 0, Allocation_Percent__c &lt; 0, Allocation_Percent__c &gt; 100, Cost_Rate__c &lt; 0)</errorConditionFormula>
    <errorMessage>Hours, allocation and cost must be valid nonnegative values.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Role_Date_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Role_Start__c)), NOT(ISBLANK(Role_End__c)), Role_End__c &lt; Role_Start__c)</errorConditionFormula>
    <errorMessage>Role End cannot precede Role Start.</errorMessage>
</ValidationRule>

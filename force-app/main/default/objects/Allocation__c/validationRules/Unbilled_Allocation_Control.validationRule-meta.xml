<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unbilled_Allocation_Control</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Classification__c, &quot;Billing&quot;)), OR(ISBLANK(Responsible_Owner__c), ISBLANK(Review_Date__c), ISBLANK(Control_Reason__c)))</errorConditionFormula>
    <errorMessage>Unbilled and internal allocations require an accountable owner, review date and control reason.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Inputs_Nonnegative</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Revenue__c &lt; 0, Base_Labour__c &lt; 0, Travel_Rate__c &lt; 0, Onsite_Months__c &lt; 0, Planned_Hours__c &lt; 0)</errorConditionFormula>
    <errorMessage>Budget values cannot be negative.</errorMessage>
</ValidationRule>

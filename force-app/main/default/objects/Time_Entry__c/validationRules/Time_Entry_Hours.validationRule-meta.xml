<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Time_Entry_Hours</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Hours__c &lt;= 0, Hours__c &gt; 24)</errorConditionFormula>
    <errorMessage>Time entry hours must be greater than zero and no more than 24.</errorMessage>
</ValidationRule>

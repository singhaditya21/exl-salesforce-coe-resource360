<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Daily_Capacity</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Daily_Capacity_Hours__c &lt;= 0, Daily_Capacity_Hours__c &gt; 24)</errorConditionFormula>
    <errorMessage>Daily capacity must be greater than zero and no more than 24 hours.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Monday_Week_Start</fullName>
    <active>true</active>
    <errorConditionFormula>WEEKDAY(Week_Start__c) &lt;&gt; 2</errorConditionFormula>
    <errorMessage>Resource 360 timesheets use a Monday week start.</errorMessage>
</ValidationRule>

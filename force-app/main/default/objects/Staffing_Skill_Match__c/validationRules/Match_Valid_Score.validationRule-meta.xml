<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Match_Valid_Score</fullName><active>true</active><errorConditionFormula>OR(Candidate_Level__c &lt; 0, Candidate_Level__c &gt; 4, Score__c &lt; 0, Score__c &gt; 100)</errorConditionFormula><errorMessage>Candidate level must be 0 to 4 and weighted score must be 0 to 100.</errorMessage></ValidationRule>

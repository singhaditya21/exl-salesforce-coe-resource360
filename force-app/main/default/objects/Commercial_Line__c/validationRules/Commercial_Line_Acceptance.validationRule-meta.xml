<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Commercial_Line_Acceptance</fullName><active>true</active><errorConditionFormula>AND(ISPICKVAL(Status__c, "Complete"), Acceptance_Required__c, NOT(ISPICKVAL(Acceptance_Status__c, "Accepted")))</errorConditionFormula><errorMessage>A required commercial acceptance must be accepted before the line can complete.</errorMessage></ValidationRule>

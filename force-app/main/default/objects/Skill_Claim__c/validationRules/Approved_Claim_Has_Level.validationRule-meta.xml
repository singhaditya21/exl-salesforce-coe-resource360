<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approved_Claim_Has_Level</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(State__c, &quot;Approved&quot;), ISBLANK(Approved_Level__c))</errorConditionFormula>
    <errorMessage>An approved skill claim requires an approved level.</errorMessage>
</ValidationRule>

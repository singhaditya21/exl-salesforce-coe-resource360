{
  "name": "exl-salesforce-coe-resource360",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "pnpm run test:unit && pnpm run test:lwc && pnpm run test:videos && pnpm run build && node --test tests/app.test.mjs",
    "test:unit": "vitest run",
    "test:lwc": "sfdx-lwc-jest -- --runInBand --testPathPattern force-app/main/default/lwc",
    "test:lwc:coverage": "sfdx-lwc-jest --coverage -- --runInBand --testPathPattern force-app/main/default/lwc",
    "test:videos": "node scripts/validate-demo-videos.mjs && node scripts/validate-master-suite-qa.mjs",
    "videos:publish-v3": "node scripts/publish-v3-masters.mjs",
    "videos:contact-sheets-v3": "node scripts/regenerate-v3-contact-sheets.mjs",
    "videos:rebuild-cta-v3": "node recordings/v3/rebuild-cta-scenes.mjs",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "lint": "eslint . --ignore-pattern dist",
    "sf:generate": "node scripts/generate-classification-metadata.mjs && node scripts/generate-policy-metadata.mjs && node scripts/generate-governance-metadata.mjs && node scripts/generate-performance-metadata.mjs && node scripts/generate-salesforce-permissions.mjs && node scripts/generate-traceability.mjs",
    "sf:validate": "sf project deploy start --source-dir force-app --target-org Resource360Hub --dry-run --test-level RunLocalTests --wait 120",
    "sf:test": "sf apex run test --target-org Resource360Hub --test-level RunLocalTests --code-coverage --result-format human --wait 120",
    "sf:test:ui": "node scripts/validate-salesforce-ui.mjs --target-org Resource360Hub",
    "sf:test:personas": "node scripts/validate-salesforce-personas.mjs --target-org Resource360Hub",
    "sf:prepare-demo": "node scripts/prepare-salesforce-demo.mjs --target-org Resource360Hub",
    "sf:deploy": "sf project deploy start --source-dir force-app --target-org Resource360Hub --test-level RunLocalTests --wait 120",
    "sf:seed": "sf apex run --target-org Resource360Hub --file scripts/apex/seedResource360.apex",
    "sf:export-pages": "node scripts/export-salesforce-pages-snapshot.mjs --target-org Resource360Hub --output public/data/salesforce-snapshot.json",
    "sf:open": "sf org open --target-org Resource360Hub --path /lightning/app/c__Resource360"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "type": "module"
}
